{
  "permissions": {
    "allow": [
      "Skill(spec-driven-change)",
      "Bash(node .claude/skills/spec-driven-change/tools/railyard.mjs:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/skills/spec-driven-change/tools/railyard.mjs\" scan --hook"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/skills/spec-driven-change/tools/railyard.mjs\" scan --hook"
          }
        ]
      }
    ]
  }
}
