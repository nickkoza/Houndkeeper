+RES = 0.05
+
+
+def _grid(w_m: float = 4.0, h_m: float = 4.0, fill: int = 0, frame_id: str = "world") -> OccupancyGrid:
+    """a free (or ``fill``) grid from (0, 0) to (w_m, h_m)"""
+    g = np.full((round(h_m / RES), round(w_m / RES)), fill, np.int8)
+    return OccupancyGrid(grid=g, resolution=RES, origin=Pose(0.0, 0.0, 0.0), frame_id=frame_id, ts=time.time())
+
+
+def _cell(grid: OccupancyGrid, x: float, y: float) -> int:
+    return int(grid.grid[int(y / RES), int(x / RES)])
+
+
+SQUARE = [[1.0, 1.0], [3.0, 1.0], [3.0, 3.0], [1.0, 3.0]]
+
+
+def test_json_round_trip_and_rejects_bad_shapes() -> None:
+    z = KeepoutZones("map", allowed=[SQUARE], walls=[[[0, 0], [1, 1]]])
+    back = KeepoutZones.from_json(z.to_json())
+    assert back.frame_id == "map" and np.allclose(back.allowed[0], SQUARE) and len(back.walls) == 1
+    assert KeepoutZones.from_json("").empty
+    with pytest.raises(ValueError):
+        KeepoutZones(allowed=[[[0, 0], [1, 1]]])  # two points: no polygon
+    with pytest.raises(ValueError):
+        KeepoutZones(walls=[[[0, 0], [1, 1], [2, 2]]])  # three points: no segment
+
+
+def test_allowed_area_marks_everything_outside_lethal_unknown_included() -> None:
+    g = _grid()
+    g.grid[:, : g.grid.shape[1] // 8] = CostValues.UNKNOWN  # an unseen strip, outside the area
+    apply_keepout_zones(g, KeepoutZones(allowed=[SQUARE]), margin_m=0.0)
+    assert _cell(g, 2.0, 2.0) == 0
+    assert _cell(g, 0.5, 2.0) == 100 and _cell(g, 0.1, 2.0) == 100  # outside, and outside unseen
+    assert _cell(g, 3.5, 3.5) == 100
+    inside = g.grid[int(1.0 / RES) + 1 : int(3.0 / RES) - 1, int(1.0 / RES) + 1 : int(3.0 / RES) - 1]
+    assert (inside == 0).all()
+
+
