+        key = config.mujoco_arm_key
+        joints = [j for j in config.mujoco_arm_joints.split(",") if j]
+        if not key or not joints:
+            return None
+        return cls(model, data, key, joints, config.mujoco_arm_gripper, config.mujoco_arm_camera)
+
+    def __init__(self, model: mujoco.MjModel, data: mujoco.MjData, key: str, joints: list[str], gripper: str, camera: str) -> None:
+        from dimos.simulation.engines.mujoco_shm import ManipShmWriter, shm_key_from_path
+
+        def actuator_of(joint_id: int) -> int:
+            for a in range(model.nu):
+                if model.actuator_trntype[a] == mujoco.mjtTrn.mjTRN_JOINT and model.actuator_trnid[a, 0] == joint_id:
+                    return a
