index 000000000..323183a87
--- /dev/null
+++ b/web/cockpit/src/panels/gamepad.test.ts
@@ -0,0 +1,103 @@
+import { describe, expect, it } from "vitest";
+import type { Msg } from "@dimos/shared";
+import { TELEOP_DEFAULTS, TeleopMachine } from "@dimos/sdk/internal/teleop";
+import {
+  applyDeadZone,
+  GAMEPAD_DEAD_ZONE,
+  GAMEPAD_DEFAULTS,
+  GAMEPAD_POLL_GAP_MS,
+  GAMEPAD_STALE_MS,
+  gamepadButtonsFromParams,
+  GamepadDriver,
+  gamepadStaleMsFromParams,
+} from "./gamepad.ts";
+
+describe("applyDeadZone", () => {
+  it("zeroes travel inside the dead zone", () => {
+    expect(applyDeadZone(0)).toBe(0);
+    expect(applyDeadZone(GAMEPAD_DEAD_ZONE)).toBe(0);
+    expect(applyDeadZone(-GAMEPAD_DEAD_ZONE / 2)).toBe(0);
+  });
+
+  it("rescales the rest to reach full scale at full travel", () => {
+    expect(applyDeadZone(1)).toBe(1);
+    expect(applyDeadZone(-1)).toBe(-1);
+    const mid = (1 + GAMEPAD_DEAD_ZONE) / 2;
+    expect(applyDeadZone(mid)).toBeCloseTo(0.5);
+    expect(applyDeadZone(-mid)).toBeCloseTo(-0.5);
+  });
+
+  it("clamps overshoot and drops junk", () => {
+    expect(applyDeadZone(1.2)).toBe(1);
+    expect(applyDeadZone(Number.NaN)).toBe(0);
+    expect(applyDeadZone(Infinity)).toBe(0);
+  });
+});
+
+describe("gamepadButtonsFromParams", () => {
+  it("defaults to LB and B / East", () => {
+    expect(gamepadButtonsFromParams({})).toEqual({ deadman: 4, stop: 1 });
+  });
+
+  it("takes valid standard-mapping indices", () => {
+    expect(gamepadButtonsFromParams({ gamepadDeadman: 7, gamepadStop: 0 }))
+      .toEqual({ deadman: 7, stop: 0 });
+  });
+
+  it("falls back per field on junk", () => {
+    expect(gamepadButtonsFromParams({ gamepadDeadman: 17, gamepadStop: 2 }))
+      .toEqual({ deadman: 4, stop: 2 });
+    expect(gamepadButtonsFromParams({ gamepadDeadman: 1.5, gamepadStop: "B" }))
+      .toEqual(GAMEPAD_DEFAULTS);
+  });
+
+  it("never lets the deadman be the STOP button", () => {
+    expect(gamepadButtonsFromParams({ gamepadDeadman: 1 })).toEqual(GAMEPAD_DEFAULTS);
+  });
+});
+
+describe("GamepadDriver liveness", () => {
+  function setup() {
+    const datagrams: Msg[] = [];
+    const machine = new TeleopMachine(TELEOP_DEFAULTS, {
+      control: () => {},
+      datagram: (m: Msg) => datagrams.push(m),
+    });
+    const driver = new GamepadDriver(machine, GAMEPAD_DEFAULTS, () => machine.arm(), () => {});
+    const buttons = Array.from({ length: 17 }, () => ({ pressed: false }));
+    const pad = {
+      index: 0,
+      id: "pad",
+      connected: true,
+      mapping: "standard",
+      axes: [0, -1],
+      buttons,
+      timestamp: 1,
+    };
+    machine.arm();
+    machine.onRelayMsg({ t: "teleop_started" } as Msg);
+    driver.poll([pad], 0);
+    buttons[GAMEPAD_DEFAULTS.deadman] = { pressed: true };
+    pad.timestamp = 2;
+    driver.poll([pad], 16);
+    return { machine, driver, datagrams };
+  }
+
+  it("polls that stop while driving let go (the frame loop paused, timers running)", () => {
+    const { machine, driver, datagrams } = setup();
+    expect(machine.getSnapshot().stick).not.toBeNull();
+    driver.watch(GAMEPAD_POLL_GAP_MS / 2);
+    expect(machine.getSnapshot().stick).not.toBeNull();
+    driver.watch(GAMEPAD_POLL_GAP_MS + 1);
+    expect(machine.getSnapshot().stick).toBeNull();
+    expect(datagrams.at(-1)).toMatchObject({ t: "twist", vx: 0, wz: 0 });
+    machine.disarm("test");
+  });
+
+  it("takes a stale window from the params within bounds", () => {
+    expect(gamepadStaleMsFromParams({})).toBe(GAMEPAD_STALE_MS);
+    expect(gamepadStaleMsFromParams({ gamepadStaleMs: 600 })).toBe(600);
+    expect(gamepadStaleMsFromParams({ gamepadStaleMs: 50 })).toBe(GAMEPAD_STALE_MS);
+    expect(gamepadStaleMsFromParams({ gamepadStaleMs: 1e9 })).toBe(GAMEPAD_STALE_MS);
+  });
+});
diff --git a/web/cockpit/src/panels/gamepad.ts b/web/cockpit/src/panels/gamepad.ts
new file mode 100644
index 000000000..b206afee5
--- /dev/null
+++ b/web/cockpit/src/panels/gamepad.ts
@@ -0,0 +1,299 @@
+// Gamepad driving for the teleop panel. The panel polls the browser Gamepad
+// API once per animation frame and hands each poll to GamepadDriver, which
+// turns the pad into the TeleopMachine's joystick calls (stickMove and
+// stickRelease). Speeds, cadence, disarm rules and the bridge deadman all
+// live in the machine, so a pad drives exactly like the touch joystick.
+//
+// Mapping (the browser's "standard" layout): the left stick drives, like the
+// touch joystick, up/down = forward/back (vx) and left/right = turn (wz);
+// the right stick stays free. A deadman button (default LB) must be held to drive; pressing
+// it arms the panel, releasing it sends a zero at once. STOP (default B /
+// East) sends a stop and a zero and disarms. Pads without the standard
+// mapping are shown but never drive: their axes mean nothing we know.
+//
+// Two liveness rules cover a pad that stops reporting while the page keeps
+// running (the bridge deadman only sees silence, and the machine's interval
+// would otherwise resend the last deflection for ever):
+// - a pad whose Gamepad.timestamp stops advancing for staleMs while the
+//   deadman is held (a Bluetooth link that froze, a driver that hung, a pad
+//   that reports "connected" with its last state) is let go: zero at once,
+//   and the deadman must be released and pressed again;
+// - polls that stop arriving (the animation frame loop paused while timers
+//   still run) are caught by watch(), which the panel calls from a timer: no
+//   poll for GAMEPAD_POLL_GAP_MS lets go the same way.
+
+import type { StickDeflection, TeleopMachine } from "@dimos/sdk/internal/teleop";
+
+/** Standard-mapping axes of the left stick (screen y grows downward). */
+const AXIS_LEFT_X = 0;
+const AXIS_LEFT_Y = 1;
+
+/** Standard-mapping button indices are 0..16. */
+export const GAMEPAD_BUTTON_COUNT = 17;
+
+export interface GamepadButtons {
+  /** Held to drive. */
+  deadman: number;
+  /** Sends a stop and a zero and disarms. */
+  stop: number;
+}
+
+export const GAMEPAD_DEFAULTS: GamepadButtons = { deadman: 4, stop: 1 };
+
+/** A held deadman whose pad's timestamp has not advanced for this long is
+ * let go. Browsers advance the timestamp on each report from the pad; a
+ * stick held perfectly still at full travel may report nothing new, so this
+ * is longer than the bridge deadman (panel param gamepadStaleMs). */
+export const GAMEPAD_STALE_MS = 1000;
+
+/** No poll for this long while driving lets go (watch()). */
+export const GAMEPAD_POLL_GAP_MS = 250;
+
+/** Stale window from the panel params (gamepadStaleMs), kept in 200..5000 ms. */
+export function gamepadStaleMsFromParams(params: Record<string, unknown>): number {
+  const v = params.gamepadStaleMs;
+  return typeof v === "number" && Number.isFinite(v) && v >= 200 && v <= 5000
+    ? v
+    : GAMEPAD_STALE_MS;
+}
+
+/** Standard-mapping button names, Xbox-style with the position for the
+ * face buttons. */
+export const GAMEPAD_BUTTON_NAMES = [
+  "A / South",
+  "B / East",
+  "X / West",
+  "Y / North",
+  "LB",
+  "RB",
+  "LT",
+  "RT",
+  "Back",
+  "Start",
+  "left stick press",
+  "right stick press",
+  "D-pad up",
+  "D-pad down",
+  "D-pad left",
+  "D-pad right",
+  "Home",
+];
+
+function buttonIndex(value: unknown, fallback: number): number {
+  return typeof value === "number" && Number.isInteger(value) && value >= 0 &&
+      value < GAMEPAD_BUTTON_COUNT
+    ? value
+    : fallback;
+}
+
+/** Button choice from the panel params (gamepadDeadman, gamepadStop).
+ * Params crossed the wire, so junk falls back per-field, and a deadman that
+ * collides with STOP falls back as a pair. */
+export function gamepadButtonsFromParams(params: Record<string, unknown>): GamepadButtons {
+  const deadman = buttonIndex(params.gamepadDeadman, GAMEPAD_DEFAULTS.deadman);
+  const stop = buttonIndex(params.gamepadStop, GAMEPAD_DEFAULTS.stop);
+  return deadman === stop ? GAMEPAD_DEFAULTS : { deadman, stop };
+}
+
+/** Stick travel below this fraction counts as centred: worn sticks rest a
+ * few percent off centre and must not creep. */
+export const GAMEPAD_DEAD_ZONE = 0.15;
+
+/** Dead zone with the rest rescaled, so the output still runs smoothly
+ * from 0 at the dead-zone edge to 1 at full travel. */
+export function applyDeadZone(value: number): number {
+  if (!Number.isFinite(value)) return 0;
+  const magnitude = Math.abs(value);
+  if (magnitude <= GAMEPAD_DEAD_ZONE) return 0;
+  const scaled = Math.min(1, (magnitude - GAMEPAD_DEAD_ZONE) / (1 - GAMEPAD_DEAD_ZONE));
+  return Math.sign(value) * scaled;
+}
+
+/** What the panel shows about the pad. */
+export interface GamepadView {
+  /** The browser's name for the pad (Gamepad.id). */
+  name: string;
+  /** False for a pad without the standard mapping, which never drives. */
+  standard: boolean;
+  /** The deadman is held and the stick is driving. */
+  driving: boolean;
+  /** The pad stopped reporting while held: let go until the deadman is
+   * pressed again. */
+  stale?: boolean;
+}
+
+/** The parts of the Gamepad API the driver reads (a structural subset, so
+ * tests can pass plain objects). */
+export interface PadState {
+  readonly index: number;
+  readonly id: string;
+  readonly connected: boolean;
+  readonly mapping: string;
+  readonly axes: readonly number[];
+  readonly buttons: readonly { readonly pressed: boolean }[];
+  /** Gamepad.timestamp: when the pad last reported. A pad without one never
+   * counts as reporting, so it cannot hold the deadman past staleMs. */
+  readonly timestamp?: number;
+}
+
+function pressed(pad: PadState, index: number): boolean {
+  return pad.buttons[index]?.pressed ?? false;
+}
+
+export class GamepadDriver {
+  #machine: TeleopMachine;
+  #buttons: GamepadButtons;
+  #arm: () => void;
+  #onView: (view: GamepadView | null) => void;
+  /** Index of the pad being followed, or null. */
+  #index: number | null = null;
+  #deadmanWas = false;
+  #stopWas = false;
+  /** Set by a deadman press, cleared by its release, STOP, any disarm and
+   * anything else that takes the stick away (Space, a lifted thumb). */
+  #engaged = false;
+  /** The machine's stick holds our deflection. */
+  #driving = false;
+  #last: StickDeflection | null = null;
+  #lastMoveMs = -Infinity;
+  #view: GamepadView | null = null;
+  #staleMs: number;
+  /** The followed pad's last timestamp and the frame time it last changed. */
+  #stamp: number | undefined = undefined;
+  #stampSinceMs = -Infinity;
+  #stale = false;
+
+  constructor(
+    machine: TeleopMachine,
+    buttons: GamepadButtons,
+    arm: () => void,
+    onView: (view: GamepadView | null) => void,
+    staleMs: number = GAMEPAD_STALE_MS,
+  ) {
+    this.#machine = machine;
+    this.#buttons = buttons;
+    this.#arm = arm;
+    this.#onView = onView;
+    this.#staleMs = staleMs;
+  }
+
+  /** Called from a timer with the time since the last poll (on the timer's
+   * own clock): polls that stopped while driving let go. */
+  watch(msSincePoll: number): void {
+    if (this.#driving && msSincePoll > GAMEPAD_POLL_GAP_MS) this.#disengage(true);
+  }
+
+  /** One frame: `pads` is navigator.getGamepads(), `nowMs` the frame time. */
+  poll(pads: readonly (PadState | null)[], nowMs: number): void {
+    if (this.#index !== null) {
+      const followed = pads[this.#index];
+      if (followed == null || !followed.connected) this.lost(this.#index);
+    }
+    let pad = this.#index === null ? null : pads[this.#index] ?? null;
+    if (pad === null) {
+      pad = pads.find((p): p is PadState => p != null && p.connected) ?? null;
+      if (pad === null) return;
+      // A newly followed pad starts from its current buttons: a deadman
+      // already held when it appears must be pressed again to drive.
+      this.#index = pad.index;
+      this.#deadmanWas = pressed(pad, this.#buttons.deadman);
+      this.#stopWas = pressed(pad, this.#buttons.stop);
+      this.#stamp = pad.timestamp;
+      this.#stampSinceMs = nowMs;
+    }
+    const stamp = typeof pad.timestamp === "number" && Number.isFinite(pad.timestamp)
+      ? pad.timestamp
+      : undefined;
+    if (stamp !== undefined && stamp !== this.#stamp) {
+      this.#stamp = stamp;
+      this.#stampSinceMs = nowMs;
+    }
+
+    const standard = pad.mapping === "standard";
+    const deadman = standard && pressed(pad, this.#buttons.deadman);
+    const stop = standard && pressed(pad, this.#buttons.stop);
+    const machine = this.#machine;
+
+    if (machine.getSnapshot().phase === "disarmed") this.#engaged = false;
+    if (this.#driving && machine.getSnapshot().stick === null) {
+      // Space, a disarm or the touch joystick took the stick: the deadman
+      // has to be pressed again.
+      this.#engaged = false;
+      this.#driving = false;
+    }
+
+    if (stop && !this.#stopWas) {
+      this.#disengage(false);
+      machine.stopOthers();
+      machine.estop();
+      machine.disarm("gamepad stop");
+    } else if (!deadman && this.#deadmanWas) {
+      this.#disengage(true);
+    } else if (deadman && !this.#deadmanWas && !stop) {
+      this.#engaged = true;
+      this.#stale = false;
+      this.#arm();
+    }
+    if (!deadman) this.#stale = false;
+    if (this.#engaged && deadman && nowMs - this.#stampSinceMs > this.#staleMs) {
+      // Held, but the pad has said nothing new for staleMs: it may be frozen
+      // with the deadman and the stick where they were. Let go; a fresh
+      // press (a release first, which a frozen pad cannot send) drives again.
+      this.#disengage(true);
+      this.#stale = true;
+    }
+    this.#deadmanWas = deadman;
+    this.#stopWas = stop;
+
+    if (this.#engaged && deadman && machine.getSnapshot().phase === "armed") {
+      const forward = applyDeadZone(-(pad.axes[AXIS_LEFT_Y] ?? 0)) || 0;
+      const turn = applyDeadZone(-(pad.axes[AXIS_LEFT_X] ?? 0)) || 0;
+      const last = this.#last;
+      const changed = last === null || last.forward !== forward || last.turn !== turn;
+      // The first deflection sends at once; later changes go out no faster
+      // than the publish cadence (the machine's interval resends the held
+      // value), so a moving stick cannot flood the channel at frame rate.
+      const due = nowMs - this.#lastMoveMs >= 1000 / machine.config.publishHz;
+      if (!this.#driving || (changed && due)) {
+        machine.stickMove(forward, turn);
+        this.#driving = machine.getSnapshot().stick !== null;
+        this.#last = { forward, turn };
+        this.#lastMoveMs = nowMs;
+      }
+    }
+
+    this.#show({ name: pad.id, standard, driving: this.#driving, stale: this.#stale });
+  }
+
+  /** The pad at `index` is gone (gamepaddisconnected, or it vanished from
+   * getGamepads): zero and disarm. */
+  lost(index: number): void {
+    if (index !== this.#index) return;
+    this.#index = null;
+    this.#deadmanWas = false;
+    this.#stopWas = false;
+    this.#disengage(true);
+    this.#machine.disarm("gamepad disconnected");
+    this.#show(null);
+  }
+
+  #disengage(release: boolean): void {
+    if (release && this.#driving) this.#machine.stickRelease();
+    this.#engaged = false;
+    this.#driving = false;
+    this.#last = null;
+    this.#lastMoveMs = -Infinity;
+  }
+
+  #show(view: GamepadView | null): void {
+    const prev = this.#view;
+    if (
+      prev === view ||
+      (prev !== null && view !== null && prev.name === view.name &&
+        prev.standard === view.standard && prev.driving === view.driving &&
+        prev.stale === view.stale)
+    ) return;
+    this.#view = view;
+    this.#onView(view);
+  }
+}
