+
+/** Thumb joystick: up/down = forward/back (vx), left/right = turn (wz). Each
+ * axis is clamped on its own, so a corner is W+A at full speed, like the
+ * keys. Pointer capture keeps the drag when the thumb leaves the base; every
+ * way a touch can end releases. */
+function Joystick({ ch, machine, stick, onGrab }: {
+  ch: string;
+  machine: TeleopMachine;
+  stick: StickDeflection | null;
+  onGrab: () => void;
+}) {
+  const pointer = useRef<number | null>(null);
+
+  const deflect = (e: PointerEvent<HTMLDivElement>) => {
+    const rect = e.currentTarget.getBoundingClientRect();
+    const radius = Math.min(rect.width, rect.height) / 2;
+    if (radius <= 0) return;
+    const dx = (e.clientX - (rect.left + rect.width / 2)) / radius;
+    const dy = (e.clientY - (rect.top + rect.height / 2)) / radius;
+    // Screen y grows downward and +wz turns left.
+    machine.stickMove(deadZone(-dy), deadZone(-dx));
+  };
