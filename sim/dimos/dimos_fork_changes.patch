+function gamepadHint(view: GamepadView, buttons: GamepadButtons): string {
+  if (!view.standard) return "unknown button layout, not used";
+  if (view.driving) return "driving - left stick";
+  if (view.stale) return "pad stopped reporting - release and press again";
