+
+def test_margin_rises_toward_the_edge_below_the_obstacle_threshold() -> None:
+    g = _grid()
+    apply_keepout_zones(g, KeepoutZones(allowed=[SQUARE]), margin_m=0.3, margin_cost=40)
+    row = int(2.0 / RES)
+    costs = [int(g.grid[row, int(x / RES)]) for x in (1.025, 1.075, 1.125, 1.225, 1.275, 1.4, 2.0)]
