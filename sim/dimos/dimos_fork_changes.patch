@@ -0,0 +1,115 @@
+// Cockpit extensions: panel modules the relay operator serves from
+// --extensions-dir, loaded before the session subscribes so the subscription
+// gate (channelSubscribable) sees their panel kinds.
+//
+// Trust boundary: code comes only from the relay's own /api/info listing,
+// which the operator controls; a robot's manifest names panel kinds, never
+// code, and listed paths outside /ext/ on this origin are refused. Built-in
+// panel kinds cannot be replaced.
+//
+// An extension module exports `register(api)` (or a default function of the
+// same shape). It receives everything a panel needs, so it can be plain
+// JavaScript with no bundler and no bare imports:
+//
+//   export function register({ React, registerPanel, PanelFrame, useStoreChannel }) {
+//     const h = React.createElement;
+//     registerPanel("battery", ({ spec, store }) => {
+//       const snap = useStoreChannel(store, spec.channels[0]);
+//       const text = snap.slot === null ? "waiting" : JSON.stringify(snap.slot.value);
+//       return h(PanelFrame, { spec, children: h("span", null, text) });
+//     });
+//   }
+
+import * as React from "react";
+import type { Decoder } from "@dimos/sdk";
+import { useStoreChannel } from "@dimos/sdk/react";
+import { PanelFrame } from "./layout/PanelFrame.tsx";
+import {
+  BUILTIN_KINDS,
+  type PanelProps,
+  recordExtensionFailure,
+  registerPanel,
+} from "./panels/registry.tsx";
+import { cockpitDecoders } from "./subscriptions.ts";
+
+/** Bumped when the api object loses or changes a member (additions do not). */
+export const EXTENSION_API_VERSION = 1;
+
+export interface ExtensionApi {
+  version: number;
+  React: typeof React;
+  registerPanel(kind: string, component: React.ComponentType<PanelProps>): void;
+  registerDecoder(encoding: string, decoder: Decoder): void;
+  PanelFrame: typeof PanelFrame;
+  useStoreChannel: typeof useStoreChannel;
+}
+
+export function extensionApi(): ExtensionApi {
+  return {
+    version: EXTENSION_API_VERSION,
+    React,
+    registerPanel(kind, component) {
+      if (BUILTIN_KINDS.has(kind)) {
+        throw new Error(`panel kind ${kind} is built in and cannot be replaced`);
+      }
+      registerPanel(kind, component);
+    },
+    registerDecoder(encoding, decoder) {
+      cockpitDecoders.register(encoding, decoder);
+    },
+    PanelFrame,
+    useStoreChannel,
+  };
+}
+
+export interface LoadDeps {
+  /** The relay's /api/info as JSON (same origin). */
+  fetchInfo?: () => Promise<unknown>;
+  /** Imports a module by absolute URL. */
+  importModule?: (url: string) => Promise<Record<string, unknown>>;
+  origin?: string;
+  api?: ExtensionApi;
+}
+
+/**
+ * Load the relay's extension modules in its listed order. Never throws: a
+ * relay without extensions, or one whose /api/info is unreachable, loads
+ * none; a module that fails is recorded (UnknownPanel shows it on the panels
+ * that needed it) and the others still load. Returns the URLs loaded.
+ */
+export async function loadExtensions(deps: LoadDeps = {}): Promise<string[]> {
+  const origin = deps.origin ?? globalThis.location.origin;
+  const fetchInfo = deps.fetchInfo ??
+    (async () => (await fetch(new URL("/api/info", origin))).json());
+  const importModule = deps.importModule ??
+    ((url: string) => import(/* @vite-ignore */ url) as Promise<Record<string, unknown>>);
+  const api = deps.api ?? extensionApi();
+  let listed: unknown;
+  try {
+    listed = ((await fetchInfo()) as { extensions?: unknown } | null)?.extensions;
+  } catch {
+    return [];
+  }
+  if (!Array.isArray(listed)) return [];
+  const loaded: string[] = [];
+  for (const path of listed) {
+    try {
+      if (typeof path !== "string" || !path.startsWith("/ext/")) {
+        throw new Error("not an /ext/ path on this relay");
+      }
+      const url = new URL(path, origin).href;
+      const mod = await importModule(url);
+      const register = mod.register ?? mod.default;
+      if (typeof register !== "function") {
+        throw new Error("exports no register(api) function");
+      }
+      await register(api);
+      loaded.push(path);
+    } catch (err) {
+      const message = err instanceof Error ? err.message : String(err);
+      recordExtensionFailure(String(path), message);
+      console.error(`[cockpit] extension ${String(path)} failed: ${message}`);
+    }
+  }
+  return loaded;
+}
