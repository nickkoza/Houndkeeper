+// @vitest-environment happy-dom
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import type { ChannelSpec, PanelSpec } from "@dimos/shared";
+import { ChannelStore } from "@dimos/sdk";
+import { extensionApi, loadExtensions } from "./extensions.ts";
+import { getExtensionFailures, getPanel, UnknownPanel } from "./panels/registry.tsx";
+import { channelSubscribable } from "./subscriptions.ts";
+
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+const ORIGIN = "https://relay.test";
+
+function deps(listing: unknown, modules: Record<string, Record<string, unknown>>) {
+  const imported: string[] = [];
+  return {
+    imported,
+    deps: {
+      origin: ORIGIN,
+      fetchInfo: () => Promise.resolve(listing),
+      importModule: (url: string) => {
+        imported.push(url);
+        const mod = modules[url];
+        return mod ? Promise.resolve(mod) : Promise.reject(new Error(`404 ${url}`));
+      },
+    },
+  };
+}
+
+function spec(kind: string, channels: string[] = []): PanelSpec {
+  return { id: "p0", kind, title: "", channels, params: {} };
+}
+
+describe("loadExtensions", () => {
+  let root: Root | null = null;
+  afterEach(() => {
+    act(() => root?.unmount());
+    root = null;
+  });
+
+  it("registers the listed modules' panel kinds, in the relay's order", async () => {
+    const order: string[] = [];
+    const { deps: d } = deps({ extensions: ["/ext/a.js", "/ext/b.mjs"] }, {
+      [`${ORIGIN}/ext/a.js`]: {
+        register: (api: ReturnType<typeof extensionApi>) => {
+          order.push("a");
+          api.registerPanel("ext-a", () => null);
+        },
+      },
+      [`${ORIGIN}/ext/b.mjs`]: {
+        default: (api: ReturnType<typeof extensionApi>) => {
+          order.push("b");
+          api.registerPanel("ext-b", () => null);
+        },
+      },
+    });
+    expect(await loadExtensions(d)).toEqual(["/ext/a.js", "/ext/b.mjs"]);
+    expect(order).toEqual(["a", "b"]);
+    expect(getPanel("ext-a")).toBeDefined();
+    expect(getPanel("ext-b")).toBeDefined();
+  });
+
+  it("lets a registered extension kind pass the subscription gate", async () => {
+    const { deps: d } = deps({ extensions: ["/ext/gate.js"] }, {
+      [`${ORIGIN}/ext/gate.js`]: {
+        register: (api: ReturnType<typeof extensionApi>) =>
+          api.registerPanel("ext-gate", () => null),
+      },
+    });
+    // A second camera: video is subscribed only for a panel this page can render.
+    const ch: ChannelSpec = {
+      ch: "wrist_image",
+      dir: "rx",
+      encoding: "jpeg.v1",
+      delivery: "latest",
+      maxHz: 10,
+      params: {},
+      publish: "none",
+      requiredScope: null,
+    };
+    expect(channelSubscribable(ch, [spec("ext-gate", ["wrist_image"])])).toBe(false);
+    await loadExtensions(d);
+    expect(channelSubscribable(ch, [spec("ext-gate", ["wrist_image"])])).toBe(true);
+  });
+
+  it("loads nothing when the relay lists no extensions or /api/info fails", async () => {
+    expect(await loadExtensions(deps({ v: 6 }, {}).deps)).toEqual([]);
+    expect(await loadExtensions(deps(null, {}).deps)).toEqual([]);
+    const failing = { origin: ORIGIN, fetchInfo: () => Promise.reject(new Error("offline")) };
+    expect(await loadExtensions(failing)).toEqual([]);
+  });
+
+  it("refuses paths outside /ext/ and keeps loading the rest", async () => {
+    const { deps: d, imported } = deps(
+      { extensions: ["https://evil.test/x.js", "/other/y.js", "/ext/ok.js"] },
+      {
+        [`${ORIGIN}/ext/ok.js`]: {
+          register: (api: ReturnType<typeof extensionApi>) =>
+            api.registerPanel("ext-ok", () => null),
+        },
+      },
+    );
+    expect(await loadExtensions(d)).toEqual(["/ext/ok.js"]);
+    expect(imported).toEqual([`${ORIGIN}/ext/ok.js`]);
+    const paths = getExtensionFailures().map((f) => f.path);
+    expect(paths).toContain("https://evil.test/x.js");
+    expect(paths).toContain("/other/y.js");
+  });
+
+  it("records a module that fails to import or register, and shows it on unknown panels", async () => {
+    const error = vi.spyOn(console, "error").mockImplementation(() => {});
+    const { deps: d } = deps({ extensions: ["/ext/missing.js", "/ext/noreg.js", "/ext/fine.js"] }, {
+      [`${ORIGIN}/ext/noreg.js`]: { something: 1 },
+      [`${ORIGIN}/ext/fine.js`]: {
+        register: (api: ReturnType<typeof extensionApi>) =>
+          api.registerPanel("ext-fine", () => null),
+      },
+    });
+    expect(await loadExtensions(d)).toEqual(["/ext/fine.js"]);
+    const failed = getExtensionFailures();
+    expect(failed.some((f) => f.path === "/ext/missing.js" && f.message.includes("404"))).toBe(
+      true,
+    );
+    expect(failed.some((f) => f.path === "/ext/noreg.js" && f.message.includes("register"))).toBe(
+      true,
+    );
+    const host = document.createElement("div");
+    root = createRoot(host);
+    act(() => root!.render(<UnknownPanel spec={spec("ext-missing")} store={new ChannelStore()} />));
+    expect(host.textContent).toContain("unknown panel kind ext-missing");
+    expect(host.textContent).toContain("extension /ext/missing.js failed to load");
+    error.mockRestore();
+  });
+
+  it("does not let an extension replace a built-in kind", async () => {
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    const builtIn = getPanel("video");
+    const { deps: d } = deps({ extensions: ["/ext/hijack.js"] }, {
+      [`${ORIGIN}/ext/hijack.js`]: {
+        register: (api: ReturnType<typeof extensionApi>) => api.registerPanel("video", () => null),
+      },
+    });
+    expect(await loadExtensions(d)).toEqual([]);
+    expect(getPanel("video")).toBe(builtIn);
+    expect(getExtensionFailures().some((f) => f.message.includes("built in"))).toBe(true);
+  });
+
+  it("gives an extension a working panel toolkit: React, the frame and the store hook", async () => {
+    const { deps: d } = deps({ extensions: ["/ext/hello.js"] }, {
+      [`${ORIGIN}/ext/hello.js`]: {
+        register: (
+          { React, registerPanel, PanelFrame, useStoreChannel }: ReturnType<typeof extensionApi>,
+        ) => {
+          const h = React.createElement;
+          registerPanel("ext-hello", ({ spec: s, store }) => {
+            const snap = useStoreChannel(store, s.channels[0] ?? "none");
+            return h(PanelFrame, {
+              spec: s,
+              children: h("span", null, `hello ${snap.slot === null ? "nothing" : "value"}`),
+            });
+          });
+        },
+      },
+    });
+    await loadExtensions(d);
+    const Hello = getPanel("ext-hello")!;
+    const host = document.createElement("div");
+    root = createRoot(host);
+    act(() => root!.render(<Hello spec={spec("ext-hello", ["x"])} store={new ChannelStore()} />));
+    expect(host.textContent).toContain("hello nothing");
+  });
+});
