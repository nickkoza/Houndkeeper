new file mode 100644
index 000000000..49d5cc997
--- /dev/null
+++ b/dimos/simulation/mujoco/odom_drift.py
@@ -0,0 +1,100 @@
+# Copyright 2025-2026 Dimensional Inc.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Odometry that drifts, as a real robot's does.
+
+The sim otherwise publishes the true pose as odometry. A real legged robot's estimate is dead reckoning: each step's
+motion is measured with a small error (a scale bias for the run, noise that grows with distance walked, heading noise
+that grows with distance and with time), and the errors add up. The believed pose is integrated from the true
+motion's increments with those errors; height, roll and pitch stay true (the IMU's gravity reference keeps them).
+The lidar's points are moved into the same believed frame, since a real robot places them with its own estimate.
+
+Configured by DIMOS_SIM_ODOM_DRIFT (GlobalConfig.mujoco_odom_drift) as comma-separated key=value pairs, e.g.
+"scale_sd=0.02,xy_sd=0.005,yaw_sd_deg=0.5,yaw_rate_sd_deg=0.05,start_xy_sd=0.02,start_yaw_sd_deg=1.0,seed=1":
+scale_sd (the run's odometry scale error), xy_sd (m per root metre walked), yaw_sd_deg (deg per root metre),
+yaw_rate_sd_deg (deg per root second), start_xy_sd (m) and start_yaw_sd_deg (deg) for where the run believes it began.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+
+import numpy as np
+
+
+def _yaw(q: np.ndarray) -> float:
+    w, x, y, z = q
+    return math.atan2(2 * (w * z + x * y), 1 - 2 * (y * y + z * z))
+
+
+def _wrap(a: float) -> float:
+    return (a + math.pi) % (2 * math.pi) - math.pi
+
+
+class OdomDrift:
+    def __init__(self, spec: str) -> None:
+        kv = dict(p.split("=") for p in spec.split(",") if "=" in p)
+        g = lambda k, d: float(kv.get(k, d))  # noqa: E731
+        self.seed = int(kv["seed"]) if "seed" in kv else int.from_bytes(os.urandom(4), "little")   # each run its own drift
+        self.rng = np.random.default_rng(self.seed)
+        print(f"[odom_drift] {spec} seed={self.seed}", flush=True)
+        self.xy_sd, self.yaw_sd = g("xy_sd", 0.0), math.radians(g("yaw_sd_deg", 0.0))
+        self.yaw_rate_sd = math.radians(g("yaw_rate_sd_deg", 0.0))
+        self.scale = 1.0 + self.rng.normal(0, g("scale_sd", 0.0))
+        self.start = (self.rng.normal(0, g("start_xy_sd", 0.0), 2), self.rng.normal(0, math.radians(g("start_yaw_sd_deg", 0.0))))
+        self.last: tuple[np.ndarray, float, float] | None = None  # true (xy, yaw, t)
+        self.belief: tuple[np.ndarray, float] | None = None       # believed (xy, yaw)
+
+    @classmethod
+    def from_spec(cls, spec: str | None) -> OdomDrift | None:
+        """the model a spec describes (GlobalConfig's matching mujoco_* option); None for an empty one"""
+        return cls(spec) if spec else None
+
+    def step(self, pos: np.ndarray, quat: np.ndarray, t: float) -> tuple[np.ndarray, np.ndarray]:
+        """the believed position and orientation (w, x, y, z) for the true ones"""
+        xy, yaw = pos[:2].astype(float), _yaw(quat)
+        if self.belief is None:
+            self.belief = (xy + self.start[0], _wrap(yaw + self.start[1]))
+        else:
+            pxy, pyaw, pt = self.last  # type: ignore[misc]
+            c, s = math.cos(pyaw), math.sin(pyaw)
+            d = np.array([[c, s], [-s, c]]) @ (xy - pxy)                  # the step, in the robot's frame then
+            ds, dt = float(np.linalg.norm(d)), max(0.0, t - pt)
+            d = d * self.scale + self.rng.normal(0, self.xy_sd * math.sqrt(ds), 2)
+            dyaw = _wrap(yaw - pyaw) + self.rng.normal(0, self.yaw_sd * math.sqrt(ds) + self.yaw_rate_sd * math.sqrt(dt))
+            bxy, byaw = self.belief
+            cb, sb = math.cos(byaw), math.sin(byaw)
+            self.belief = (bxy + np.array([[cb, -sb], [sb, cb]]) @ d, _wrap(byaw + dyaw))
+        self.last = (xy, yaw, t)
+        bxy, byaw = self.belief
+        half = (byaw - yaw) / 2                                           # turn the true orientation about world z
+        qz = np.array([math.cos(half), 0.0, 0.0, math.sin(half)])
+        w1, x1, y1, z1 = qz
+        w2, x2, y2, z2 = quat
+        qb = np.array([w1 * w2 - x1 * x2 - y1 * y2 - z1 * z2, w1 * x2 + x1 * w2 + y1 * z2 - z1 * y2,
+                       w1 * y2 - x1 * z2 + y1 * w2 + z1 * x2, w1 * z2 + x1 * y2 - y1 * x2 + z1 * w2])
+        return np.array([bxy[0], bxy[1], pos[2]]), qb
+
+    def to_belief(self, points: np.ndarray) -> np.ndarray:
+        """world points (N x 3) as the robot's believed frame places them"""
+        if self.belief is None or self.last is None:
+            return points
+        (txy, tyaw, _), (bxy, byaw) = self.last, self.belief
+        a = byaw - tyaw; c, s = math.cos(a), math.sin(a)
+        out = points.copy()
+        rel = points[:, :2] - txy
+        out[:, 0] = bxy[0] + c * rel[:, 0] - s * rel[:, 1]
+        out[:, 1] = bxy[1] + s * rel[:, 0] + c * rel[:, 1]
+        return out
