+    if (pointer.current !== null) return; // one thumb drives
+    pointer.current = e.pointerId;
+    e.currentTarget.setPointerCapture?.(e.pointerId);
+    onGrab();
+    deflect(e);
+  };
+  const onPointerMove = (e: PointerEvent<HTMLDivElement>) => {
+    if (e.pointerId === pointer.current) deflect(e);
+  };
+  const onPointerEnd = (e: PointerEvent<HTMLDivElement>) => {
+    if (e.pointerId !== pointer.current) return;
+    pointer.current = null;
+    machine.stickRelease();
+  };
+  const onTouchEnd = () => {
+    // Belt to the pointer events' braces: a browser that drops the
+    // pointerup still delivers touchend.
+    pointer.current = null;
+    machine.stickRelease();
+  };
