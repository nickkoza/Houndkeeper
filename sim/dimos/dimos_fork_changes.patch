+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""A camera stream over Wi-Fi, as it arrives: some frames never do, and now and then the stream stalls for a moment
+and nothing arrives at all.
+
+Configured by DIMOS_SIM_STREAM (GlobalConfig.mujoco_stream), e.g. "drop=0.03,stall_per_min=2,stall_s=0.6,burst_share=0.5": the share of frames lost
+singly, stalls a minute (a Poisson process), each stall's mean length (s, exponential), and the share of a stall's
+frames a jitter buffer holds and lets through in a burst when it ends (the rest are lost; default 0); seed optional.
+"""
+
+from __future__ import annotations
+
+
+import numpy as np
+
+
+class StreamModel:
+    def __init__(self, spec: str) -> None:
+        kv = dict(p.split("=") for p in spec.split(",") if "=" in p)
+        self.drop = float(kv.get("drop", 0.0)); self.stall_rate = float(kv.get("stall_per_min", 0.0)) / 60.0
+        self.stall_s = float(kv.get("stall_s", 0.5)); self.burst_share = float(kv.get("burst_share", 0.0))
+        self.rng = np.random.default_rng(int(kv["seed"]) if "seed" in kv else None)
+        self.until = -1.0; self.last = None
+
+    @classmethod
+    def from_spec(cls, spec: str | None) -> StreamModel | None:
+        """the model a spec describes (GlobalConfig's matching mujoco_* option); None for an empty one"""
+        return cls(spec) if spec else None
+
+    def arrival(self, t: float) -> float | None:
+        """when the frame taken at t (s, the robot's clock) gets through to the robot's software: t, or a stall's end for a
+        frame held through it (late in a burst, not lost); None if it never does"""
+        dt = 0.0 if self.last is None else max(0.0, t - self.last); self.last = t
+        if t < self.until: return self._held()
+        if self.rng.random() < 1 - np.exp(-self.stall_rate * dt):           # a stall starts
+            self.until = t + self.rng.exponential(self.stall_s); return self._held()
+        return t if self.rng.random() >= self.drop else None
+
+    def _held(self) -> float | None:
+        return self.until if self.burst_share > 0 and self.rng.random() < self.burst_share else None
+
+    def delivered(self, t: float) -> bool:
+        """does the frame taken at t reach the robot's software on time (not lost, not held by a stall)"""
+        return self.arrival(t) == t
