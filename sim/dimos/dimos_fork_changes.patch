+def test_arm_camera_throttle() -> None:
+    always = ArmCameraThrottle(np.zeros(3))
+    assert always.due(np.zeros(3), t=1.0, last_t=0.99)
+    throttle = ArmCameraThrottle(np.zeros(3), idle_s=1.0, rest_tol=0.15)
+    assert throttle.due([0.0, 0.5, 0.0], t=1.0, last_t=0.99)   # out of rest: every frame
+    assert not throttle.due([0.0, 0.1, 0.0], t=1.5, last_t=1.0)   # resting: not yet idle_s since the last
+    assert throttle.due([0.0, 0.1, 0.0], t=2.0, last_t=1.0)
