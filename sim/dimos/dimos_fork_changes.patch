+        if (self.frame_id, self.child_frame_id) != (other.frame_id, other.child_frame_id):
+            raise ValueError(
+                f"Cannot interpolate {self.frame_id} -> {self.child_frame_id} "
+                f"with {other.frame_id} -> {other.child_frame_id}"
+            )
+        span = other.ts - self.ts
+        f = 0.0 if span == 0 else (ts - self.ts) / span
+        a, b = self.translation, other.translation
+        return Transform(
+            translation=Vector3(
+                a.x * (1 - f) + b.x * f,
+                a.y * (1 - f) + b.y * f,
+                a.z * (1 - f) + b.z * f,
+            ),
+            rotation=self.rotation.slerp(other.rotation, f),
+            frame_id=self.frame_id,
+            child_frame_id=self.child_frame_id,
+            ts=ts,
+        )
+
     def __neg__(self) -> Transform:
         """Unary minus operator returns the inverse transform."""
         return self.inverse()
