+"""Odometry that reaches the robot's computer late and unevenly: each message is held until it
+would have arrived (a mean delay with jitter), in the order sent, and stamped as DimOS's Go2 connection stamps it: on
+arrival, with the host's clock (`time_is_now`, as of a7492431f), unless stamp="source" (the time it
+describes, as once the robot's own time is carried). The shared memory holds one message, so each tick the newest
+arrived one is what the robot sees. Times are the robot's clock (dimos.utils.clock: sim time in a sim)."""
+import numpy as np
+
+from dimos.simulation.mujoco.delay_line import DelayLine
+
+
+class OdomDelay:
+    def __init__(self, mean_s: float, jitter_s: float, seed: int | None = None, stamp: str = "arrival"):
+        self.line, self.stamp = DelayLine(mean_s, jitter_s, seed), stamp
+
+    @classmethod
+    def from_spec(cls, v: str | None):
+        """from "mean_s,jitter_s[,stamp]" (GlobalConfig.mujoco_odom_delay); None for an empty spec or no delay"""
+        if not v: return None
+        p = v.split(","); mean, jitter = float(p[0]), float(p[1]); stamp = p[2] if len(p) > 2 else "arrival"
+        return cls(mean, jitter, stamp=stamp) if mean or jitter else None
+
+    def push(self, t: float, pos, quat):
+        """send the state at time t; returns (pos, quat, stamp) of the newest message arrived by t, or None: the stamp its
+        arrival (the host's clock) or, with stamp="source", the time it describes"""
+        self.line.push(t, (np.array(pos, float), np.array(quat, float)))
+        due = self.line.due(t)
+        if not due: return None
+        r, sent, (pos, quat) = due[-1]
+        return pos, quat, (sent if self.stamp == "source" else r)
