+class ArmCameraThrottle:
+    """When to render a camera on the arm: every frame while the arm is out of its rest pose, and while it rests (every
+    joint within rest_tol rad of rest_q) at most every idle_s of sim time, since a resting arm's camera sees the same
+    view frame after frame. idle_s 0 renders it every frame."""
+
+    def __init__(self, rest_q: Any, idle_s: float = 0.0, rest_tol: float = 0.15) -> None:
+        self.rest_q = np.asarray(rest_q, float)
+        self.idle_s, self.rest_tol = idle_s, rest_tol
+
+    @classmethod
+    def from_config(cls, model: mujoco.MjModel, qadr: Any, config: GlobalConfig) -> "ArmCameraThrottle":
+        """rest pose from mujoco_arm_camera_rest_pose, or else the "home" keyframe's (the model's initial pose
+        without one)"""
+        qadr = np.asarray(qadr, int)
+        if config.mujoco_arm_camera_rest_pose.strip():
+            rest = [float(v) for v in config.mujoco_arm_camera_rest_pose.split(",")]
+            if len(rest) != len(qadr):
+                raise ValueError(f"mujoco_arm_camera_rest_pose has {len(rest)} values for {len(qadr)} arm joints")
+        else:
+            home = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_KEY, "home")
+            rest = (model.key_qpos[home] if home >= 0 else model.qpos0)[qadr]
+        return cls(rest, config.mujoco_arm_camera_idle_s, config.mujoco_arm_camera_rest_tol)
+
+    def due(self, arm_q: Any, t: float, last_t: float) -> bool:
+        resting = float(np.max(np.abs(np.asarray(arm_q, float) - self.rest_q))) <= self.rest_tol
+        if self.idle_s <= 0 or not resting:
+            return True
+        return not 0 <= t - last_t < self.idle_s   # (a reset that turns sim time back renders at once)
+
+
+def frame_steps(steps_per_frame: int, robot: str, timestep: float) -> int:
+    """Physics steps per loop frame: a finer step than the robot's own (mujoco_dt) takes proportionally more, so a
+    frame covers the same sim time and the viewer, odometry and pacing are unchanged."""
+    return steps_per_frame * max(1, round(default_timestep(robot) / timestep))
+
