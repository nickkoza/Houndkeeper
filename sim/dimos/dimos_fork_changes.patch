index 000000000..578368d02
--- /dev/null
+++ b/dimos/utils/clock.py
@@ -0,0 +1,232 @@
+# Copyright 2025-2026 Dimensional Inc.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""The robot's clock: what a module reads for "now" when it judges sensor data (a message's age, a timeout, a control
+rate, a stuck window).
+
+On a robot it is the host's wall clock, `time.time()`, the clock DimOS stamps messages with. In a simulation that runs
+slower or faster than real time it is a clock that advances with sim time, as ROS's `use_sim_time` and `/clock` do:
+the sim publishes it (`SimClock`), stamps every message on it, and holds every injected delay on it; modules read it
+through `now()`, `sleep()` and `wait()`. A sim run at any speed then looks the same from the robot's side, and its
+speed is a cost, never a variable.
+
+`DIMOS_SIM_CLOCK` names the block the sim publishes (a file under /dev/shm, or an absolute path). Unset, or before the
+sim has written it, `now()` is the wall clock. The sim's clock starts at the wall time of its first tick, so the hand-
+over is seamless. A clock nobody has advanced for `STALE_S` of wall time (the sim gone) runs on at wall speed from its
+last value."""
+
+from __future__ import annotations
+
+import mmap
+import os
+import struct
+import tempfile
+import threading
+import time
+from typing import Protocol
+
+ENV = "DIMOS_SIM_CLOCK"
+STALE_S = 30.0          # wall seconds without a tick before the sim counts as gone
+_FMT = "<Qdddd"         # seq (odd while writing), robot time, sim time, host wall time, sim/wall ratio
+_SIZE = struct.calcsize(_FMT)
+_wall = time.time        # the host's wall clock (a test may stand a fake one in)
+
+
+def clock_path(name: str | None = None) -> str | None:
+    """the file a clock name stands for: an absolute path as given, else under /dev/shm (the temp dir off Linux)"""
+    name = os.environ.get(ENV, "") if name is None else name
+    if not name:
+        return None
+    if os.path.isabs(name):
+        return name
+    base = "/dev/shm" if os.path.isdir("/dev/shm") else tempfile.gettempdir()
+    return os.path.join(base, name)
+
+
+class Source(Protocol):
+    def now(self) -> float: ...
+    def sleep(self, seconds: float) -> None: ...
+
+
+class SimClock:
+    """The sim's side: robot time for a sim time, published for every process to read.
+
+    Robot time is the wall time of the first tick plus the sim time since, so at real-time speed it is the wall clock.
+    A sim reset that turns sim time back carries robot time on from where it was: it never runs backwards. With no
+    path (DIMOS_SIM_CLOCK unset) and follow_sim False it is the wall clock, as DimOS's sim stamped before."""
+
+    def __init__(self, path: str | None = None, follow_sim: bool = True) -> None:
+        self.path, self.follow_sim = path, follow_sim
+        self._epoch: float | None = None; self._sim0 = 0.0; self._offset = 0.0
+        self._last_sim = None; self._last_robot = None
+        self._seq = 0; self._mm = None; self._fh = None
+        self._win = None; self.ratio = 1.0; self._ratio_set = False                     # rolling sim/wall rate (an EMA over >= 1 s windows)
+        self._host0 = None; self._simstart = None
+        if path:
+            self._fh = open(path, "w+b"); self._fh.write(b"\0" * _SIZE); self._fh.flush()
+            self._mm = mmap.mmap(self._fh.fileno(), _SIZE)
+
+    @classmethod
+    def from_env(cls) -> SimClock:
+        """published at DIMOS_SIM_CLOCK and following sim time; unset: the wall clock, unpublished"""
+        p = clock_path()
+        return cls(p, follow_sim=True) if p else cls(None, follow_sim=False)
+
+    def at(self, sim_t: float) -> float:
+        """robot time for sim time sim_t (the current offset; a reset is noticed at the next tick)"""
+        if not self.follow_sim:
+            return _wall()
+        if self._epoch is None:
+            return _wall()
+        return self._epoch + (sim_t - self._sim0) + self._offset
+
+    def tick(self, sim_t: float, host_t: float | None = None) -> float:
+        """advance to sim time sim_t (once per sim loop) and publish; returns robot time"""
+        host_t = _wall() if host_t is None else host_t
+        if self._epoch is None:
+            self._epoch, self._sim0 = host_t, sim_t; self._host0, self._simstart = host_t, sim_t
+        if self.follow_sim and self._last_sim is not None and sim_t < self._last_sim:   # reset: carry on from where it was
+            self._offset += self._last_robot - self.at(sim_t)
+        t = self.at(sim_t) if self.follow_sim else host_t
+        self._last_sim, self._last_robot = sim_t, t
+        if self._win is None:
+            self._win = (host_t, sim_t)
+        elif host_t - self._win[0] >= 1.0:
+            inst = max(0.0, sim_t - self._win[1]) / (host_t - self._win[0])
+            self.ratio = 0.7 * self.ratio + 0.3 * inst if self._ratio_set else inst; self._ratio_set = True
+            self._win = (host_t, sim_t)
+        if self._mm is not None:
+            self._seq += 1; struct.pack_into("<Q", self._mm, 0, self._seq)                        # odd: being written
+            struct.pack_into("<dddd", self._mm, 8, t, sim_t, host_t, self.ratio if self.follow_sim else 1.0)
+            self._seq += 1; struct.pack_into("<Q", self._mm, 0, self._seq)
+        return t
+
+    def mean_ratio(self, sim_t: float, host_t: float | None = None) -> float:
+        """sim/wall over the whole run so far"""
+        host_t = _wall() if host_t is None else host_t
+        if self._host0 is None or host_t <= self._host0:
+            return 1.0
+        return (sim_t - self._simstart) / (host_t - self._host0)
+
+    def close(self) -> None:
+        if self._mm is not None:
+            self._mm.close(); self._fh.close(); self._mm = None
+            try:
+                os.unlink(self.path)
+            except OSError:
+                pass
+
+
+class _Reader:
+    """the robot's side of a published SimClock (seqlock reads; monotonic per process)"""
+
+    def __init__(self) -> None:
+        self._mm = None; self._path = None; self._tried = -1e9; self._last = -1e300; self._lock = threading.Lock()
+
+    def _map(self, path: str):
+        if self._mm is not None and self._path == path:
+            return self._mm
+        now = time.monotonic()
+        if now - self._tried < 0.5:                     # a missing block is looked for at most twice a second
+            return None
+        self._tried = now
+        try:
+            with open(path, "rb") as fh:
+                self._mm = mmap.mmap(fh.fileno(), _SIZE, access=mmap.ACCESS_READ); self._path = path
+        except (OSError, ValueError):
+            self._mm = None
+        return self._mm
+
+    def state(self) -> tuple[float, float, float, float] | None:
+        """(robot t, sim t, host t, ratio) as last published, or None: no sim clock"""
+        path = clock_path()
+        if not path:
+            return None
+        mm = self._map(path)
+        if mm is None:
+            return None
+        for _ in range(100):
+            s1 = struct.unpack_from("<Q", mm, 0)[0]
+            vals = struct.unpack_from("<dddd", mm, 8)
+            s2 = struct.unpack_from("<Q", mm, 0)[0]
+            if s1 == s2 and s1 % 2 == 0:
+                return None if s1 == 0 else vals
+        return None
+
+    def now(self) -> float:
+        st = self.state()
+        if st is None:
+            t = _wall()
+        else:
+            robot_t, _sim_t, host_t, _r = st
+            wall = _wall()
+            t = robot_t + (wall - host_t - STALE_S) if wall - host_t > STALE_S else robot_t   # the sim gone: wall speed
+        with self._lock:
+            self._last = t = max(self._last, t)
+        return t
+
+    def ratio(self) -> float:
+        st = self.state()
+        return 1.0 if st is None else max(st[3], 1e-3)
+
+
+_reader = _Reader()
+_source: Source | None = None
+
+
+def set_source(source: Source | None) -> None:
+    """use another clock (a test's fake sim clock); None: back to the wall or the published sim clock"""
+    global _source
+    _source = source
+
+
+def now() -> float:
+    """the robot's time (s, on the clock messages are stamped with)"""
+    return _source.now() if _source is not None else _reader.now()
+
+
+def ratio() -> float:
+    """how fast the robot's clock runs against the wall clock (1 on a robot)"""
+    return 1.0 if _source is not None else _reader.ratio()
+
+
+def sleep(seconds: float) -> None:
+    """sleep until the robot's clock has advanced by seconds"""
+    if _source is not None:
+        _source.sleep(seconds); return
+    if _reader.state() is None:
+        time.sleep(max(0.0, seconds)); return
+    end = now() + seconds
+    while True:
+        rem = end - now()
+        if rem <= 0:
+            return
+        time.sleep(min(rem / ratio(), 0.05))
+
+
+def wait(event: threading.Event, seconds: float) -> bool:
+    """wait for event, or until the robot's clock has advanced by seconds; True if the event is set"""
+    if _source is not None:
+        if event.is_set():
+            return True
+        _source.sleep(seconds); return event.is_set()
+    if _reader.state() is None:
+        return event.wait(max(0.0, seconds))
+    end = now() + seconds
+    while True:
+        rem = end - now()
+        if rem <= 0:
+            return event.is_set()
+        if event.wait(min(rem / ratio(), 0.05)):
+            return True
