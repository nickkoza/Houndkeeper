+# limitations under the License.
+
+"""A real lidar's points, from the sim's dense depth cameras.
+
+The sim's lidar is three wide depth cameras: every pixel becomes an exact point. A real lidar returns a fixed number
+of points a second (the Go2's L1: 21,600 over its field of view, in a non-repeating pattern), each with range noise,
+and none closer than its minimum range. This keeps that many of the depth points each tick, drawn evenly over solid
+angle (a wide pinhole camera packs its edge pixels densely in angle, so they're weighted down by cos^3), moves each
+along its ray by the range noise, and drops those too close.
+
+Configured by DIMOS_SIM_LIDAR_MODEL (GlobalConfig.mujoco_lidar_model), e.g. "points_per_s=21600,range_sd=0.02,min_range=0.05": points a second over
+all the depth cameras together, range noise (m, one sigma), minimum range (m); seed optional. Surfaces that return
+little: dark_albedo (below it, returns start to go missing), dark_drop (the share missing on black), shiny_drop (glass,
+screens and mirrors, by material name).
+"""
+
+from __future__ import annotations
+
+
+import numpy as np
+
+
+class LidarModel:
+    def __init__(self, spec: str) -> None:
+        kv = dict(p.split("=") for p in spec.split(",") if "=" in p)
+        self.rate = float(kv.get("points_per_s", 21600)); self.range_sd = float(kv.get("range_sd", 0.02))
+        self.min_range = float(kv.get("min_range", 0.05))
+        self.rng = np.random.default_rng(int(kv["seed"]) if "seed" in kv else None)
+        self.dark_albedo = float(kv.get("dark_albedo", 0.0))                # below this albedo returns start to go missing
+        self.dark_drop = float(kv.get("dark_drop", 0.0))                    # the share missing on a black surface
+        self.shiny_drop = float(kv.get("shiny_drop", 0.0))                  # the share missing on glass, screens, mirrors
+        self.geom_drop: np.ndarray | None = None
+
+    @property
+    def needs_segmentation(self) -> bool:
+        return self.dark_drop > 0 or self.shiny_drop > 0
+
+    def surfaces(self, model) -> None:
+        """each geom's chance of returning nothing: dark surfaces absorb the laser, glass and screens reflect it away.
+        Albedo is the geom's colour times its texture's mean (a material's rgba and texture, or the geom's own rgba)"""
+        import mujoco
+        drop = np.zeros(model.ngeom)
+        tex_mean = {}
+        for g in range(model.ngeom):
+            mat = model.geom_matid[g]; rgba = model.mat_rgba[mat] if mat >= 0 else model.geom_rgba[g]
+            alb = float(np.dot(rgba[:3], [0.2126, 0.7152, 0.0722]))
+            name = (mujoco.mj_id2name(model, mujoco.mjtObj.mjOBJ_MATERIAL, mat) or "") if mat >= 0 else ""
+            if mat >= 0:
+                t = int(model.mat_texid[mat, int(mujoco.mjtTextureRole.mjTEXROLE_RGB)])
+                if t >= 0:
+                    if t not in tex_mean:
+                        a, n, h, w = model.tex_adr[t], model.tex_nchannel[t], model.tex_height[t], model.tex_width[t]
+                        px = model.tex_data[a:a + n * h * w].reshape(-1, n)[:, :3].astype(float) / 255.0
+                        tex_mean[t] = float(np.dot(px.mean(0), [0.2126, 0.7152, 0.0722]))
+                    alb *= tex_mean[t]
+            if any(k in name for k in ("glass", "screen", "mirror")): drop[g] = self.shiny_drop
+            elif self.dark_albedo > 0 and alb < self.dark_albedo:
+                drop[g] = self.dark_drop * (1 - alb / self.dark_albedo)
+        self.geom_drop = drop
+
+    def dropped(self, geoms: np.ndarray) -> np.ndarray:
+        """which returns go missing this time, by the geom each hit (-1: none)"""
+        if self.geom_drop is None: return np.zeros(geoms.shape, bool)
+        p = np.where(geoms >= 0, self.geom_drop[np.clip(geoms, 0, len(self.geom_drop) - 1)], 0.0)
+        return self.rng.random(geoms.shape) < p
+
+    def hit_geoms(self, model, data, cam_pos: np.ndarray, points: np.ndarray, groups) -> np.ndarray:
+        """the geom each return came from: a ray from the lidar to each point (mj_multiRay)"""
+        import mujoco
+        if not len(points): return np.zeros(0, np.int32)
+        d = points - cam_pos; dist = np.linalg.norm(d, axis=1); u = (d / np.maximum(dist, 1e-9)[:, None]).ravel()
+        geomid = np.zeros(len(points), np.int32); out = np.zeros(len(points))
+        mujoco.mj_multiRay(model, data, np.asarray(cam_pos, float), u, groups, 1, -1, geomid, out, None, len(points), float(dist.max()) + 1.0)
+        return geomid
+
+    @classmethod
+    def from_spec(cls, spec: str | None) -> LidarModel | None:
+        """the model a spec describes (GlobalConfig's matching mujoco_* option); None for an empty one"""
+        return cls(spec) if spec else None
+
+    def sample(self, points: np.ndarray, cam_pos: np.ndarray, cam_mat: np.ndarray, dt: float) -> np.ndarray:
+        """the points one depth camera's share of the lidar returns in dt seconds"""
+        ray = points - cam_pos; rng_m = np.linalg.norm(ray, axis=1); ok = rng_m > self.min_range
+        points, ray, rng_m = points[ok], ray[ok], rng_m[ok]
+        if not len(points): return points
+        u = ray / rng_m[:, None]
+        cos = np.clip(u @ -cam_mat[:, 2], 1e-3, 1.0)                      # angle off the camera's axis (MuJoCo looks down -z)
+        w = cos ** 3; w /= w.sum()
+        n = min(len(points), int(self.rng.poisson(self.rate * dt)))
+        idx = self.rng.choice(len(points), size=n, replace=False, p=w)
+        noisy = rng_m[idx] + self.rng.normal(0, self.range_sd, n)
+        return cam_pos + u[idx] * noisy[:, None]
