+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Leg postures for the simulated quadruped (stand, crouch, lie down) held by stiff leg PD targets while the walking
+policy is paused, so a robot can stop and lower itself, as the real Go2 does on StandDown / StandUp."""
+
+from typing import Any
+
+import mujoco
+import numpy as np
+
+WALK, LIE, CROUCH, STAND = 0, 1, 2, 3
+
+
+def _pose(thigh: float, calf: float, hip: float = 0.1) -> np.ndarray[Any, Any]:
+    return np.array([hip, thigh, calf, -hip, thigh, calf, hip, thigh, calf, -hip, thigh, calf])
+
+
+# Go1 leg order FR, FL, RR, RL (hip, thigh, calf); values found in sim, not from Unitree.
+POSES = {"unitree_go1": {STAND: _pose(0.9, -1.8), CROUCH: _pose(1.1, -2.3), LIE: _pose(1.2, -2.6)}}
+POSE_KP, POSE_KD, MOVE_S = 120.0, 3.0, 2.0
+
+
+class PostureController:
+    """Moves the legs to a posture over MOVE_S seconds (smooth), then holds it. Stiff gains while posed; the walking
+    policy's own gains are restored by release()."""
+
+    def __init__(self, model: mujoco.MjModel, data: mujoco.MjData, target: np.ndarray[Any, Any]) -> None:
+        self._n = len(target)
+        self._saved = (model.actuator_gainprm[: self._n].copy(), model.actuator_biasprm[: self._n].copy())
+        model.actuator_gainprm[: self._n, 0] = POSE_KP
+        model.actuator_biasprm[: self._n, 1] = -POSE_KP
+        model.actuator_biasprm[: self._n, 2] = -POSE_KD
+        self._start = data.qpos[7 : 7 + self._n].copy()
+        self._target = np.asarray(target, dtype=float)
+        self._t0 = data.time
+
+    def step(self, model: mujoco.MjModel, data: mujoco.MjData) -> None:
+        a = min(1.0, (data.time - self._t0) / (0.8 * MOVE_S))
+        a = 0.5 - 0.5 * np.cos(np.pi * a)
+        data.ctrl[: self._n] = (1 - a) * self._start + a * self._target
+
+    def release(self, model: mujoco.MjModel) -> None:
+        model.actuator_gainprm[: self._n] = self._saved[0]
+        model.actuator_biasprm[: self._n] = self._saved[1]
diff --git a/dimos/simulation/mujoco/scene_from_map.py b/dimos/simulation/mujoco/scene_from_map.py
new file mode 100644
index 000000000..e0c51731f
--- /dev/null
+++ b/dimos/simulation/mujoco/scene_from_map.py
@@ -0,0 +1,416 @@
+# Copyright 2025-2026 Dimensional Inc.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""A MuJoCo scene built from what a robot mapped: a simulated copy of a real place.
+
+Goes one step past `dimos.mapping.occupancy.extrude_occupancy`, which extrudes an occupancy grid
+to fixed-height red boxes. Here the inputs are a robot's own map products in one world frame:
+
+- a `HeightGrid`: per cell, the lowest and highest return standing above the floor, built from
+  lidar points (`HeightGrid.from_points`, e.g. a recording's accumulated `lidar` or `global_map`);
+- optionally a `FloorPicture`: the floor's colour on a grid (a mosaic of the robot's camera
+  frames projected to the floor) and where it was seen.
+
+The scene keeps what was mapped and invents nothing:
+
+- each mapped column becomes a box from the floor to its top, or a slab where the floor beneath
+  it was seen (a table top: the robot can see and reach under it); a pocket wholly enclosed by
+  mapped columns with no seen floor in it is the inside of something solid, and is filled;
+- cells the map never saw get no geometry, and floor the camera never saw is one flat marker
+  colour rather than a guess;
+- tops clipped by the map's own height limit can be extended to a stated ceiling (a lidar map
+  usually drops returns above some height, so a wall's top is unknown, not low).
+
+Robot-agnostic: the scene has no robot in it; DimOS's sim adds one (`model.get_model_xml`).
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+import io
+from pathlib import Path
+
+import numpy as np
+from numpy.typing import NDArray
+from PIL import Image
+from scipy import ndimage
+
+UNSEEN_FLOOR_RGB = (128, 128, 128)
+
+
+def estimate_floor_z(points: NDArray[np.floating], bin_size: float = 0.01) -> float:
+    """The floor's height: the densest 1 cm band of heights in the lower half of the points."""
+    z = np.asarray(points, dtype=float)[:, 2]
+    if len(z) == 0:
+        return 0.0
+    low = z[z <= np.median(z)]
+    edges = np.arange(low.min(), low.max() + 2 * bin_size, bin_size)
+    counts, edges = np.histogram(low, bins=edges)
+    k = int(np.argmax(counts))
+    return float((edges[k] + edges[k + 1]) / 2)
+
+
+@dataclass
+class HeightGrid:
+    """What stands above the floor, per cell, in metres above the floor.
+
+    Grid convention as `OccupancyGrid`: cell (row, col) covers x from `origin[0] + col * resolution`
+    and y from `origin[1] + row * resolution`; rows grow with y. NaN where nothing was mapped.
+    """
+
+    bottom: NDArray[np.float32]
+    top: NDArray[np.float32]
+    resolution: float
+    origin: tuple[float, float]
+
+    @property
+    def occupied(self) -> NDArray[np.bool_]:
+        return np.isfinite(self.top)
+
+    @classmethod
+    def from_points(
+        cls,
+        points: NDArray[np.floating],
+        resolution: float = 0.05,
+        *,
+        floor_z: float | None = None,
+        min_height: float = 0.10,
+        max_height: float | None = None,
+        min_hits: int = 2,
+        origin: tuple[float, float] | None = None,
+        shape: tuple[int, int] | None = None,
+    ) -> HeightGrid:
+        """Bin points (N x 3, world frame) into columns.
+
+        Args:
+            points: lidar returns in the world frame.
+            resolution: cell size and height step (m).
+            floor_z: the floor's height in the points' frame; estimated when None.
+            min_height: returns lower than this above the floor are floor (and its noise).
+            max_height: returns higher than this are dropped (a ceiling), if given.
+            min_hits: a voxel (cell x height step) needs this many returns; fewer is noise.
+            origin, shape: the grid; by default the points' footprint.
+        """
+        p = np.asarray(points, dtype=float).reshape(-1, 3)
+        fz = estimate_floor_z(p) if floor_z is None else floor_z
+        z = p[:, 2] - fz
+        keep = z > min_height
+        if max_height is not None:
+            keep &= z < max_height
+        p, z = p[keep], z[keep]
+        if origin is None:
+            lo = np.floor(p[:, :2].min(0) / resolution) * resolution if len(p) else np.zeros(2)
+            origin = (float(lo[0]), float(lo[1]))
+        if shape is None:
+            hi = p[:, :2].max(0) if len(p) else np.array(origin)
+            shape = (
+                int((hi[1] - origin[1]) // resolution) + 1,
+                int((hi[0] - origin[0]) // resolution) + 1,
+            )
+        rows, cols = shape
+        bottom = np.full(rows * cols, np.nan, np.float32)
+        top = np.full(rows * cols, np.nan, np.float32)
+        j = np.floor((p[:, 0] - origin[0]) / resolution).astype(np.int64)
+        i = np.floor((p[:, 1] - origin[1]) / resolution).astype(np.int64)
+        k = np.floor(z / resolution).astype(np.int64)
+        inside = (i >= 0) & (i < rows) & (j >= 0) & (j < cols)
+        cell, k = i[inside] * cols + j[inside], k[inside]
+        if len(cell):
+            nz = int(k.max()) + 1
+            voxels, hits = np.unique(cell * nz + k, return_counts=True)
+            voxels = voxels[hits >= min_hits]
+            vc, vk = voxels // nz, voxels % nz
+            np.fmin.at(bottom, vc, (vk * resolution).astype(np.float32))
+            np.fmax.at(top, vc, ((vk + 1) * resolution).astype(np.float32))
+        return cls(
+            bottom=bottom.reshape(shape),
+            top=top.reshape(shape),
+            resolution=resolution,
+            origin=origin,
+        )
+
+
+@dataclass
+class FloorPicture:
+    """The floor's colour on a grid (same convention as `HeightGrid`), and where it was seen."""
+
+    rgb: NDArray[np.uint8]
+    seen: NDArray[np.bool_]
+    resolution: float
+    origin: tuple[float, float]
+
+    @property
+    def extent(self) -> tuple[float, float, float, float]:
+        """(x0, y0, x1, y1) in metres."""
+        rows, cols = self.seen.shape
+        x0, y0 = self.origin
+        return x0, y0, x0 + cols * self.resolution, y0 + rows * self.resolution
+
+    def png(self, unseen_rgb: tuple[int, int, int] = UNSEEN_FLOOR_RGB) -> bytes:
+        """The texture: the picture with unseen floor flat, top row at +y as MuJoCo lays it on a plane."""
+        img = np.where(self.seen[..., None], self.rgb, np.array(unseen_rgb, np.uint8))
+        buf = io.BytesIO()
+        Image.fromarray(np.ascontiguousarray(img[::-1]).astype(np.uint8)).save(buf, format="PNG")
+        return buf.getvalue()
+
+
+@dataclass(frozen=True)
+class Box:
+    """An axis-aligned box in the world frame (m)."""
+
+    x0: float
+    y0: float
+    x1: float
+    y1: float
+    z0: float
+    z1: float
+
+
+@dataclass(frozen=True)
+class Light:
+    """A MuJoCo light, as its MJCF attributes."""
+
+    name: str
+    pos: tuple[float, float, float]
+    diffuse: tuple[float, float, float]
+    dir: tuple[float, float, float] = (0.0, 0.0, -1.0)
+    directional: bool = False
+    cutoff: float = 85.0
+    exponent: float = 1.0
+    attenuation: tuple[float, float, float] = (1.0, 0.0, 0.0)
+    bulbradius: float = 0.02
+    specular: tuple[float, float, float] = (0.0, 0.0, 0.0)
+
+    def xml(self) -> str:
+        def f(v: tuple[float, float, float]) -> str:
+            return " ".join(f"{x:.3f}" for x in v)
+
+        kind = ' directional="true"' if self.directional else ""
+        return (
+            f'    <light name="{self.name}"{kind} pos="{f(self.pos)}" dir="{f(self.dir)}" '
+            f'cutoff="{self.cutoff:g}" exponent="{self.exponent:g}" diffuse="{f(self.diffuse)}" '
+            f'specular="{f(self.specular)}" attenuation="{f(self.attenuation)}" '
+            f'bulbradius="{self.bulbradius:.3f}"/>'
+        )
+
+
+DEFAULT_LIGHTS = (
+    Light("sun", (0.0, 0.0, 6.0), (0.7, 0.7, 0.7), dir=(0.2, 0.3, -1.0), directional=True),
+)
+
+
+def _rectangles(mask: NDArray[np.bool_]) -> list[tuple[int, int, int, int]]:
+    """Cover a mask with rectangles (row0, col0, row1, col1; inclusive): each row's runs, merged with
+    the identical run in the rows below. Linear in the mask's size."""
+    out: list[tuple[int, int, int, int]] = []
+    open_: dict[tuple[int, int], int] = {}
+    for r in range(mask.shape[0] + 1):
+        runs: set[tuple[int, int]] = set()
+        if r < mask.shape[0]:
+            row = np.concatenate([[False], mask[r], [False]])
+            d = np.flatnonzero(row[1:] != row[:-1])
+            runs = {(int(a), int(b) - 1) for a, b in zip(d[::2], d[1::2], strict=True)}
+        for run in list(open_):
+            if run not in runs:
+                out.append((open_.pop(run), run[0], r - 1, run[1]))
+        for run in runs:
+            open_.setdefault(run, r)
+    return out
+
+
+def boxes_from_heights(
+    grid: HeightGrid,
+    *,
+    floor_seen: NDArray[np.bool_] | None = None,
+    min_clearance: float = 0.25,
+    min_cells: int = 2,
+    fill_enclosed_m2: float = 6.0,
+    fill_gap_cells: int = 2,
+    clipped_above: float | None = None,
+    extend_to: float | None = None,
+) -> list[Box]:
+    """The grid's columns as boxes.
+
+    Args:
+        grid: the height grid.
+        floor_seen: cells whose floor was observed (a camera saw it). A column over seen floor
+            whose lowest return is above `min_clearance` becomes a slab from that height (a table
+            top); elsewhere every column stands on the floor (a lidar sees a sofa's seat, not the
+            sofa under it, so a high lowest return alone is no proof of clearance). Without it:
+            no slabs, and no filling.
+        min_clearance: the clearance (m) that makes a slab.
+        min_cells: connected groups of fewer occupied cells are dropped as noise.
+        fill_enclosed_m2: an unmapped pocket wholly enclosed by mapped columns, holding no seen
+            floor and no larger than this, is the inside of something solid (a lidar returns
+            only from an object's faces): filled, as tall as the nearest column. Gaps of up to
+            `fill_gap_cells` in its faces still enclose it (returns are sparse along a face).
+        clipped_above: tops at or above this were cut by the map's own height limit...
+        extend_to: ...and are extended to this height (a ceiling), if both are given.
+    """
+    occ = grid.occupied
+    lab, n = ndimage.label(occ, structure=np.ones((3, 3)))
+    if n:
+        sizes = ndimage.sum(occ, lab, index=np.arange(1, n + 1))
+        occ = occ & np.isin(lab, 1 + np.flatnonzero(sizes >= min_cells))
+    step = grid.resolution
+    top = np.where(occ, grid.top, np.nan)
+    bottom = np.where(occ, grid.bottom, np.nan)
+    clear = np.zeros(occ.shape, bool)
+    if floor_seen is not None:
+        shut = ndimage.binary_closing(occ, np.ones((3, 3)), iterations=fill_gap_cells) | occ
+        holes = ndimage.binary_fill_holes(shut) & ~shut
+        hl, hn = ndimage.label(holes)
+        if hn:
+            area = ndimage.sum(holes, hl, index=np.arange(1, hn + 1)) * step**2
+            seen = ndimage.sum(floor_seen, hl, index=np.arange(1, hn + 1))
+            fill = np.isin(hl, 1 + np.flatnonzero((area <= fill_enclosed_m2) & (seen == 0)))
+            fill = (
+                ndimage.binary_dilation(fill, np.ones((3, 3)), iterations=fill_gap_cells)
+                & ~occ
+                & ~floor_seen
+            )
+            if fill.any():
+                _, (ri, ci) = ndimage.distance_transform_edt(~occ, return_indices=True)
+                top = np.where(fill, top[ri, ci], top)
+                bottom = np.where(fill, 0.0, bottom)
+                occ = occ | fill
+        clear = (np.nan_to_num(bottom, nan=0.0) > min_clearance) & floor_seen
+    z0 = np.where(clear, bottom, 0.0)
+    z1 = np.nan_to_num(top, nan=0.0)
+    if clipped_above is not None and extend_to is not None:
+        z1 = np.where(z1 >= clipped_above, extend_to, z1)
+    k0 = np.round(z0 / step).astype(np.int64)
+    k1 = np.round(z1 / step).astype(np.int64)
+    ox, oy = grid.origin
+    boxes: list[Box] = []
+    keys = np.unique(np.stack([k0[occ], k1[occ]], 1), axis=0).reshape(-1, 2)
+    for a, b in keys:
+        for r0, c0, r1, c1 in _rectangles(occ & (k0 == a) & (k1 == b)):
+            boxes.append(
+                Box(
+                    x0=ox + c0 * step,
+                    y0=oy + r0 * step,
+                    x1=ox + (c1 + 1) * step,
+                    y1=oy + (r1 + 1) * step,
+                    z0=float(a * step),
+                    z1=float(b * step),
+                )
+            )
+    return boxes
+
+
+@dataclass
+class MapScene:
+    """A scene's MJCF and the asset files it names (for `MjModel.from_xml_string(xml, assets)`)."""
+
+    name: str
+    xml: str
+    assets: dict[str, bytes] = field(default_factory=dict)
+    boxes: list[Box] = field(default_factory=list)
+
+    def write(self, directory: str | Path) -> Path:
+        """Write `<name>.xml` and its assets side by side; returns the XML's path."""
+        d = Path(directory)
+        d.mkdir(parents=True, exist_ok=True)
+        for fname, data in self.assets.items():
+            (d / fname).write_bytes(data)
+        path = d / f"{self.name}.xml"
+        path.write_text(self.xml)
+        return path
+
+
+def build_scene(
+    boxes: Sequence[Box],
+    floor: FloorPicture | None = None,
+    *,
+    name: str = "map_scene",
+    lights: Sequence[Light] = DEFAULT_LIGHTS,
+    ceiling: float | None = None,
+    unseen_rgb: tuple[int, int, int] = UNSEEN_FLOOR_RGB,
+    structure_rgba: tuple[float, float, float, float] = (0.85, 0.83, 0.79, 1.0),
+    headlight: tuple[tuple[float, float, float], tuple[float, float, float]] = (
+        (0.6, 0.6, 0.6),
+        (0.35, 0.35, 0.35),
+    ),
+) -> MapScene:
+    """The MJCF scene: a floor plane (textured with `floor` over its extent), the boxes, the lights,
+    and optionally a ceiling slab at `ceiling` m over the floor's extent.
+
+    Args:
+        headlight: the headlight's (diffuse, ambient) colours: MuJoCo's ambient fill for every
+            camera, part of a scene's lighting.
+    """
+    assets: dict[str, bytes] = {}
+    if floor is not None:
+        x0, y0, x1, y1 = floor.extent
+    elif boxes:
+        x0, y0 = min(b.x0 for b in boxes), min(b.y0 for b in boxes)
+        x1, y1 = max(b.x1 for b in boxes), max(b.y1 for b in boxes)
+    else:
+        x0, y0, x1, y1 = -5.0, -5.0, 5.0, 5.0
+    cx, cy, hx, hy = (x0 + x1) / 2, (y0 + y1) / 2, (x1 - x0) / 2, (y1 - y0) / 2
+    rgba = " ".join(f"{c:g}" for c in structure_rgba)
+    asset = [f'    <material name="{name}_structure" rgba="{rgba}"/>']
+    if floor is not None:
+        tex = f"{name}_floor.png"
+        assets[tex] = floor.png(unseen_rgb)
+        asset += [
+            f'    <texture type="2d" name="{name}_floor" file="{tex}"/>',
+            f'    <material name="{name}_floor" texture="{name}_floor" texrepeat="1 1" '
+            'texuniform="false"/>',
+        ]
+    else:
+        asset += [
+            f'    <texture type="2d" name="{name}_floor" builtin="flat" width="8" height="8" '
+            f'rgb1="{" ".join(f"{c / 255:.3f}" for c in unseen_rgb)}"/>',
+            f'    <material name="{name}_floor" texture="{name}_floor"/>',
+        ]
+    world = [light.xml() for light in lights]
+    world.append(
+        f'    <geom name="floor" type="plane" pos="{cx:.4f} {cy:.4f} 0" size="{hx:.4f} {hy:.4f} 0.1" '
+        f'material="{name}_floor" contype="1" conaffinity="1" priority="1" friction="1.0"/>'
+    )
+    for i, b in enumerate(boxes):
+        world.append(
+            f'    <geom name="map_box_{i}" type="box" '
+            f'pos="{(b.x0 + b.x1) / 2:.4f} {(b.y0 + b.y1) / 2:.4f} {(b.z0 + b.z1) / 2:.4f}" '
+            f'size="{(b.x1 - b.x0) / 2:.4f} {(b.y1 - b.y0) / 2:.4f} {(b.z1 - b.z0) / 2:.4f}" '
+            f'material="{name}_structure" contype="1" conaffinity="1"/>'
+        )
+    if ceiling is not None:
+        world.append(
+            f'    <geom name="ceiling" type="box" pos="{cx:.4f} {cy:.4f} {ceiling + 0.01:.4f}" '
+            f'size="{hx:.4f} {hy:.4f} 0.01" material="{name}_structure" contype="0" conaffinity="0"/>'
+        )
+    hd, ha = (" ".join(f"{c:.3f}" for c in v) for v in headlight)
+    xml = "\n".join(
+        [
+            '<?xml version="1.0" ?>',
+            f'<mujoco model="{name}">',
+            '  <compiler angle="radian"/>',
+            "  <asset>",
+            *asset,
+            "  </asset>",
+            "  <worldbody>",
+            *world,
+            "  </worldbody>",
+            "  <visual>",
+            f'    <headlight diffuse="{hd}" ambient="{ha}" specular="0.05 0.05 0.05"/>',
+            "  </visual>",
+            "</mujoco>",
+            "",
+        ]
+    )
+    return MapScene(name=name, xml=xml, assets=assets, boxes=list(boxes))
