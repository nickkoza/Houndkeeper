+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Keep-out zones and virtual walls as a costmap layer.
+
+A virtual boundary drawn on a map, in the spirit of Nav2's keepout filter: the
+cells it forbids are marked lethal in the navigation costmap, so planners and
+frontier exploration treat them as walls, while the sensors, the point cloud
+and the map built from them are never touched.
+
+* ``allowed``: polygons the robot must stay inside (an operating area). With
+  any given, every cell outside all of them is lethal, unknown cells included,
+  so exploration finds no frontier there.
+* ``keepout``: polygons the robot must stay out of.
+* ``walls``: line segments it must not cross, e.g. across a doorway.
+
+Inside the edge, known cells get a soft margin of rising cost (kept below the
+planners' obstacle threshold), so a path keeps off the boundary rather than
+hugging it. A robot found on a lethal cell of the layer (pushed out, or
+relocalized) gets a passable band between it and the nearest allowed cell, so
+it can plan the shortest way back in, and nowhere else.
+
+On the wire the zones are JSON (a ``std_msgs/String``)::
+
+    {"frame_id": "map", "allowed": [[[x, y], ...], ...],
+     "keepout": [[[x, y], ...], ...], "walls": [[[x1, y1], [x2, y2]], ...]}
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+import json
+from typing import Any
+
+import numpy as np
+from numpy.typing import NDArray
+from scipy import ndimage
+
+from dimos.msgs.nav_msgs.OccupancyGrid import CostValues, OccupancyGrid
+
+
+def _polygon(points: Any) -> NDArray[np.float64]:
+    p = np.asarray(points, np.float64).reshape(-1, 2)
+    if len(p) < 3:
+        raise ValueError(f"a polygon needs 3 or more points, got {len(p)}")
+    return p
+
+
+def _segment(points: Any) -> NDArray[np.float64]:
+    s = np.asarray(points, np.float64).reshape(-1, 2)
+    if len(s) != 2:
+        raise ValueError(f"a wall is a segment of 2 points, got {len(s)}")
+    return s
+
+
+@dataclass
+class KeepoutZones:
+    """Allowed areas, keep-out zones and virtual walls in one frame."""
+
+    frame_id: str = "world"
+    allowed: list[NDArray[np.float64]] = field(default_factory=list)
+    keepout: list[NDArray[np.float64]] = field(default_factory=list)
+    walls: list[NDArray[np.float64]] = field(default_factory=list)
+
+    def __post_init__(self) -> None:
+        self.allowed = [_polygon(p) for p in self.allowed]
+        self.keepout = [_polygon(p) for p in self.keepout]
+        self.walls = [_segment(s) for s in self.walls]
+
+    @property
+    def empty(self) -> bool:
+        return not (self.allowed or self.keepout or self.walls)
+
+    @classmethod
+    def from_json(cls, text: str) -> KeepoutZones:
+        d = json.loads(text) if text and text.strip() else {}
+        return cls(
+            frame_id=d.get("frame_id", "world"),
+            allowed=d.get("allowed", []),
+            keepout=d.get("keepout", []),
+            walls=d.get("walls", []),
+        )
+
+    def to_json(self) -> str:
+        r = lambda arrs: [np.round(a, 4).tolist() for a in arrs]  # noqa: E731
+        return json.dumps(
+            {
+                "frame_id": self.frame_id,
+                "allowed": r(self.allowed),
+                "keepout": r(self.keepout),
+                "walls": r(self.walls),
+            }
+        )
+
+    def transformed(self, matrix: Any, frame_id: str) -> KeepoutZones:
+        """The zones moved by a 3x3 (SE(2)) or 4x4 (SE(3), its planar part) transform into ``frame_id``."""
+        m = np.asarray(matrix, np.float64)
+        rot, t = (m[:2, :2], m[:2, 2]) if m.shape == (3, 3) else (m[:2, :2], m[:2, 3])
+        mv = lambda arrs: [a @ rot.T + t for a in arrs]  # noqa: E731
+        return KeepoutZones(frame_id, mv(self.allowed), mv(self.keepout), mv(self.walls))
+
+    def contains(self, x: float, y: float) -> bool:
+        """Whether a point is allowed: inside an allowed area (if any), outside every keep-out zone."""
+        p = np.array([[x, y]])
+        if self.allowed and not any(_inside(p, a)[0] for a in self.allowed):
+            return False
+        return not any(_inside(p, k)[0] for k in self.keepout)
+
+
+def _inside(points: NDArray[np.float64], poly: NDArray[np.float64]) -> NDArray[np.bool_]:
+    """Even-odd point-in-polygon for many points (N x 2)."""
+    x, y = points[:, 0], points[:, 1]
+    inside = np.zeros(len(points), bool)
+    xj, yj = poly[-1]
+    for xi, yi in poly:
+        crosses = (yi > y) != (yj > y)
+        with np.errstate(divide="ignore", invalid="ignore"):
+            x_at = (xj - xi) * (y - yi) / (yj - yi) + xi
+        inside ^= crosses & (x < x_at)
+        xj, yj = xi, yi
+    return inside
+
+
+def _segment_distance(px: Any, py: Any, seg: NDArray[np.float64]) -> Any:
+    (ax, ay), (bx, by) = seg
+    dx, dy = bx - ax, by - ay
+    length2 = dx * dx + dy * dy
+    t = np.clip(((px - ax) * dx + (py - ay) * dy) / length2, 0.0, 1.0) if length2 > 0 else 0.0
+    return np.hypot(px - (ax + t * dx), py - (ay + t * dy))
+
+
+def lethal_mask(grid: OccupancyGrid, zones: KeepoutZones, wall_width_m: float = 0.1) -> NDArray[np.bool_]:
+    """Cells the zones forbid, by each cell's centre; walls by any cell the segment passes through, so a
+    diagonal wall leaves no gap a planner could cut a corner through."""
+    h, w = grid.grid.shape
+    res = grid.resolution
+    ox, oy = grid.origin.position.x, grid.origin.position.y
+    rows, cols = np.mgrid[:h, :w]
+    centres = np.c_[(cols.ravel() + 0.5) * res + ox, (rows.ravel() + 0.5) * res + oy]
+    out = np.zeros(h * w, bool)
+    if zones.allowed:
+        inside = np.zeros(h * w, bool)
+        for poly in zones.allowed:
+            inside |= _inside(centres, poly)
+        out |= ~inside
+    for poly in zones.keepout:
+        out |= _inside(centres, poly)
+    out = out.reshape(h, w)
+    if zones.walls:
+        cx = (np.arange(w) + 0.5) * res + ox
+        cy = (np.arange(h) + 0.5) * res + oy
+        reach = max(wall_width_m / 2, res * np.sqrt(0.5))  # half a cell's diagonal: every cell it touches
+        for seg in zones.walls:
+            out |= _segment_distance(cx[None, :], cy[:, None], seg) <= reach + 1e-9
+    return out
+
+
+def apply_keepout_zones(
+    grid: OccupancyGrid,
+    zones: KeepoutZones,
+    *,
+    margin_m: float = 0.3,
+    margin_cost: int = 40,
+    wall_width_m: float = 0.1,
+    robot_xy: tuple[float, float] | None = None,
+    escape_slack_m: float = 0.5,
+    escape_cost: int = 49,
+) -> NDArray[np.bool_]:
+    """Mark the zones on ``grid`` in place (the zones already in the grid's frame). Returns the lethal mask.
+
+    margin_m, margin_cost: known cells within margin_m of a forbidden cell cost up to margin_cost, falling
+        linearly to 0 at margin_m (never lowering a cost the grid already has; unknown cells stay unknown).
+    robot_xy: the robot's position in the grid's frame; when it stands on a forbidden cell, the forbidden
+        cells no further from the allowed ones, nor from the robot, than it is from the allowed ones (plus
+        escape_slack_m) cost escape_cost instead: a passable way back in. Cells the grid itself marks lethal
+        stay lethal.
+    """
+    if zones.empty or grid.grid.size == 0:
+        return np.zeros(grid.grid.shape, bool)
+    g = grid.grid
+    res = grid.resolution
+    lethal = lethal_mask(grid, zones, wall_width_m)
+    known = g != CostValues.UNKNOWN
+    if margin_m > 0 and margin_cost > 0 and lethal.any() and (~lethal).any():
+        dist = ndimage.distance_transform_edt(~lethal) * res  # m from each allowed cell to the nearest forbidden one
+        ramp = np.ceil(margin_cost * (1.0 - dist / margin_m)).clip(0, margin_cost)
+        soft = known & ~lethal & (ramp > 0)
+        g[soft] = np.maximum(g[soft], ramp[soft].astype(g.dtype))
+    escape = np.zeros_like(lethal)
+    if robot_xy is not None and lethal.any() and (~lethal).any():
+        c = int((robot_xy[0] - grid.origin.position.x) / res)
+        r = int((robot_xy[1] - grid.origin.position.y) / res)
+        if 0 <= r < g.shape[0] and 0 <= c < g.shape[1] and lethal[r, c]:
+            back = ndimage.distance_transform_edt(lethal) * res  # m from each forbidden cell to the nearest allowed one
+            reach = back[r, c] + escape_slack_m
+            rows, cols = np.ogrid[: g.shape[0], : g.shape[1]]
+            near = np.hypot(rows - r, cols - c) * res <= reach  # and no further from the robot: the way in, not round
+            escape = lethal & near & (back <= reach) & (g < CostValues.OCCUPIED)
+    g[lethal & ~escape] = CostValues.OCCUPIED
+    g[escape] = escape_cost
+    return lethal
