+def _yawed(parent: str, child: str, x: float, yaw: float, ts: float) -> Transform:
+    return Transform(
+        frame_id=parent,
+        child_frame_id=child,
+        translation=Vector3(x, 0.0, 0.0),
+        rotation=Quaternion.from_euler(Vector3(0.0, 0.0, yaw)),
+        ts=ts,
+    )
+
+
+# Epoch stamps (~1.7e9 s) carry ~2e-7 s of float resolution, so a fraction of
+# a 0.1 s gap is good to ~1e-6: interpolated values are compared to that.
