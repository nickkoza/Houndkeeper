+def _cloud(points: list[list[float]]) -> PointCloud2:
+    return PointCloud2.from_numpy(np.array(points, np.float32), frame_id="world", timestamp=time.time())
+
+
+def test_default_occupancy_config_is_stock() -> None:
+    cfg = Config().config
+    assert isinstance(cfg, HeightCostConfig)
+    assert cfg.can_pass_under == 0.6 and cfg.ignore_above is None
+
+
+def test_sparse_mapping_builds_the_algorithms_config_with_typed_values() -> None:
+    cfg = Config(config={"can_pass_under": "2.5", "ignore_above": "2.0"}).config
+    assert cfg == HeightCostConfig(can_pass_under=2.5, ignore_above=2.0)
+    general = Config(algo="general", config={**vars(HeightCostConfig()), "max_height": 1.5}).config
+    assert general == GeneralOccupancyConfig(max_height=1.5)
+
+
+def test_unknown_occupancy_field_is_rejected() -> None:
+    with pytest.raises(ValueError, match="can_pass_undr"):
+        Config(config={"can_pass_undr": 1.0})
+
+
+@pytest.mark.parametrize("algo", sorted(OCCUPANCY_ALGOS))
+def test_ignore_above_drops_only_higher_points(algo: str) -> None:
+    floor = [[x * 0.05, y * 0.05, 0.0] for x in range(20) for y in range(20)]
+    ceiling = [[x * 0.05, y * 0.05, 2.4] for x in range(20) for y in range(20)]
+    fn = OCCUPANCY_ALGOS[algo]
+    kept = fn(_cloud(floor + ceiling))
+    dropped = fn(_cloud(floor + ceiling), ignore_above=2.0)
+    floor_only = fn(_cloud(floor))
+    assert (dropped.grid == floor_only.grid).all()
+    assert kept.grid.shape == floor_only.grid.shape
