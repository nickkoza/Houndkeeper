+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""A link between the robot and the computer reading it: each message is held until it would have arrived, a mean
+delay with jitter after it was sent (or after a stall let it through), in the order sent. Times are the robot's clock
+(`dimos.utils.clock`: sim time in a sim), so a sim running slower or faster than real time delays its messages by the
+same robot time, and nothing is readable before it has arrived.
+
+Spec "mean_s,jitter_s" (e.g. DIMOS_SIM_CMD_DELAY="0.05,0.02"); both 0 or unset: no delay line."""
+
+from __future__ import annotations
+
+from typing import Any
+
+import numpy as np
+
+
+class DelayLine:
+    def __init__(self, mean_s: float, jitter_s: float, seed: int | None = None) -> None:
+        self.mean, self.jitter = float(mean_s), float(jitter_s)
+        self.rng = np.random.default_rng(seed)
+        self.queue: list[tuple[float, float, Any]] = []      # (arrival, sent, message), arrival non-decreasing
+        self.release = -float("inf")
+
+    @classmethod
+    def from_spec(cls, spec: str | None, seed: int | None = None) -> DelayLine | None:
+        if not spec:
+            return None
+        p = [float(v) for v in spec.split(",")[:2]]
+        mean, jitter = p[0], (p[1] if len(p) > 1 else 0.0)
+        return cls(mean, jitter, seed) if mean or jitter else None
+
+    def delay(self) -> float:
+        return max(0.0, self.mean + self.rng.normal(0, self.jitter))
+
+    def push(self, t: float, msg: Any, through: float | None = None) -> float:
+        """send msg at robot time t; through: when the link let it through (a stall's end), if later than t. Returns
+        when it arrives (never before an earlier message: the link keeps order)"""
+        self.release = max(self.release, max(t, through if through is not None else t) + self.delay())
+        self.queue.append((self.release, t, msg))
+        return self.release
+
+    def due(self, t: float, limit: int | None = None) -> list[tuple[float, float, Any]]:
+        """the messages arrived by robot time t, oldest first, as (arrival, sent, message); at most limit of them (the
+        rest stay queued: a single-slot reader takes one at a time)"""
+        n = 0
+        while n < len(self.queue) and self.queue[n][0] <= t and (limit is None or n < limit):
+            n += 1
+        out, self.queue = self.queue[:n], self.queue[n:]
+        return out
+
+    def __len__(self) -> int:
+        return len(self.queue)
