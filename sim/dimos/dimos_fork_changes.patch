+def sensor_scene_option(geomgroups: str) -> mujoco.MjvOption:
+    """The scene option the robot's cameras and depth sensors render with: geomgroups "0,1,2,4" shows exactly those
+    geom groups (e.g. walls in a group the viewer hides); empty keeps MuJoCo's default."""
+    option = mujoco.MjvOption()
+    if geomgroups.strip():
+        shown = {int(g) for g in geomgroups.split(",") if g.strip()}
+        for g in range(len(option.geomgroup)):
+            option.geomgroup[g] = int(g in shown)
+    return option
+
