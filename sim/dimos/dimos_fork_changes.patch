+def _out_and_back_stream() -> Stream[PointCloud2]:
+    """The robot drives 6 m out along a structured room and back, 1 s a frame,
+    so the return revisits the start long after it left: a loop closure."""
+    rng = np.random.default_rng(1)
+    mem = MemoryStore()
+    lidar: Stream[PointCloud2] = mem.stream("lidar", PointCloud2)
+    # A room of walls and pillars, fixed in the world.
+    walls = [np.c_[rng.uniform(-2, 9, 400), np.full(400, y), rng.uniform(0, 1, 400)] for y in (-1.5, 1.5)]
+    pillars = [np.c_[px + 0.1 * rng.standard_normal(80), py + 0.1 * rng.standard_normal(80), rng.uniform(0, 1, 80)]
+               for px, py in ((0.5, 0.8), (2.5, -0.9), (4.0, 0.7), (6.5, -0.6))]
+    world_pts = np.vstack(walls + pillars).astype(np.float32)
+    xs = list(np.arange(0.0, 6.01, 0.6)) + list(np.arange(5.4, -0.01, -0.6))
+    for i, x in enumerate(xs, start=1):
+        yaw = 0.05 if i <= 11 else 0.05 + np.pi
+        q = Rotation.from_euler("z", yaw).as_quat()
+        near = world_pts[np.abs(world_pts[:, 0] - x) < 4.0]
+        lidar.append(
+            PointCloud2.from_numpy(near, timestamp=float(i * 3)),
+            ts=float(i * 3),
+            pose=(float(x) + 0.01, 0.0, 0.0, float(q[0]), float(q[1]), float(q[2]), float(q[3])),
+        )
+    return lidar
+
+
+class TestLoopVerifier:
+    def test_default_accepts_loops(self) -> None:
+        graph = _out_and_back_stream().transform(PGO()).last().data
+        assert len(graph.loops) >= 1
+
+    def test_verifier_sees_each_candidate_and_rejecting_drops_it(self) -> None:
+        from dimos.mapping.loop_closure.pgo import LoopCandidate
+
+        seen: list[LoopCandidate] = []
+
+        def reject(c: LoopCandidate) -> bool:
+            seen.append(c)
+            return False
+
+        graph = _out_and_back_stream().transform(PGO(loop_verifier=reject)).last().data
+        assert seen, "the verifier was never asked"
+        assert len(graph.loops) == 0
+        c = seen[0]
+        assert c.source_ts > c.target_ts
+        assert c.score >= 0.0
+        assert c.source_cloud is not None and len(c.source_cloud) > 0
+        assert c.target_cloud is not None and len(c.target_cloud) > 0
+
+    def test_accepting_verifier_changes_nothing(self) -> None:
+        plain = _out_and_back_stream().transform(PGO()).last().data
+        verified = _out_and_back_stream().transform(PGO(loop_verifier=lambda c: True)).last().data
+        assert len(verified.loops) == len(plain.loops)
