+
+from collections.abc import Iterable
+from pathlib import Path
+from typing import Any
+
+import mujoco
+import numpy as np
+import pytest
+
+from dimos.simulation.mujoco.scene_from_map import (
+    UNSEEN_FLOOR_RGB,
+    Box,
+    FloorPicture,
+    HeightGrid,
+    _rectangles,
+    boxes_from_heights,
+    build_scene,
+    estimate_floor_z,
+)
+from dimos.utils.data import get_data
+
+
+def _room(floor_z: float = -0.2) -> np.ndarray:
+    """A 4 x 3 m room's returns: walls to 1.5 m, a 1 x 0.5 m table top at 0.7 m on one leg, and
+    floor returns, all `floor_z` below the frame's origin."""
+    rng = np.random.default_rng(0)
+    pts: list[tuple[float, float, float]] = []
+    for z in np.arange(0.0, 1.5, 0.02):
+        for x in np.arange(0.0, 4.0, 0.02):
+            pts += [(float(x), 0.01, float(z)), (float(x), 2.99, float(z))]
+        for y in np.arange(0.0, 3.0, 0.02):
+            pts += [(0.01, float(y), float(z)), (3.99, float(y), float(z))]
+    for x in np.arange(1.5, 2.5, 0.02):
+        for y in np.arange(1.0, 1.5, 0.02):
+            pts.append((float(x), float(y), 0.71))
+    for z in np.arange(0.0, 0.7, 0.02):
+        pts.append((1.51, 1.01, float(z)))
+    floor = np.c_[rng.uniform(0, 4, 4000), rng.uniform(0, 3, 4000), rng.normal(0, 0.005, 4000)]
+    p = np.vstack([np.array(pts), floor])
+    p[:, 2] += floor_z
+    return np.repeat(p, 2, axis=0)  # every return seen twice (min_hits)
+
+
+def test_floor_height_is_found() -> None:
+    assert estimate_floor_z(_room(-0.2)) == pytest.approx(-0.2, abs=0.01)
+
+
+def test_heights_from_points() -> None:
+    g = HeightGrid.from_points(_room(), resolution=0.05)
+    assert g.origin == pytest.approx((0.0, 0.0))
+    i, j = int(1.2 / 0.05), int(2.0 / 0.05)  # under the table top
+    assert g.bottom[i, j] == pytest.approx(0.70) and g.top[i, j] == pytest.approx(0.75)
+    assert g.top[0, 40] == pytest.approx(1.5, abs=0.05)  # a wall
+    assert not np.isfinite(g.top[int(2.5 / 0.05), int(3.0 / 0.05)])  # open floor: nothing
+
+
+def test_rectangles_cover_the_mask_exactly() -> None:
+    rng = np.random.default_rng(1)
+    m = rng.random((40, 50)) > 0.6
+    cover = np.zeros_like(m, dtype=int)
+    for r0, c0, r1, c1 in _rectangles(m):
+        cover[r0 : r1 + 1, c0 : c1 + 1] += 1
+    assert (cover == m).all()
+
+
+def test_slab_only_where_the_floor_under_it_was_seen() -> None:
+    g = HeightGrid.from_points(_room(), resolution=0.05)
+    assert not any(b.z0 > 0 for b in boxes_from_heights(g))  # no evidence of clear floor: no slabs
+    under = np.zeros(g.top.shape, bool)
+    under[int(1.0 / 0.05) : int(1.5 / 0.05), int(1.5 / 0.05) : int(2.5 / 0.05)] = True
+    boxes = boxes_from_heights(g, floor_seen=under, clipped_above=1.45, extend_to=2.4)
+    slabs = [b for b in boxes if b.z0 > 0]
+    assert slabs and all(b.z0 == pytest.approx(0.70) and b.z1 == pytest.approx(0.75) for b in slabs)
+    assert max(b.z1 for b in boxes) == pytest.approx(2.4)
+    leg = [b for b in boxes if b.z0 == 0 and b.z1 == pytest.approx(0.75)]
+    assert len(leg) == 1  # the leg column stands on the floor up to the top
+
+
+def test_specks_are_dropped() -> None:
+    top = np.full((10, 10), np.nan, np.float32)
+    top[5, 5] = 0.5
+    top[1:3, 1:4] = 0.5
+    g = HeightGrid(
+        bottom=np.where(np.isfinite(top), 0.1, np.nan), top=top, resolution=0.1, origin=(0, 0)
+    )
+    boxes = boxes_from_heights(g, min_cells=2)
+    assert len(boxes) == 1 and (boxes[0].x0, boxes[0].x1) == pytest.approx((0.1, 0.4))
+
+
+def test_scene_loads_with_its_floor_texture() -> None:
+    rgb = np.zeros((300, 400, 3), np.uint8)
+    rgb[:150] = (200, 50, 50)  # the low-y half red
+    seen = np.ones((300, 400), bool)
+    seen[:, 350:] = False
+    floor = FloorPicture(rgb=rgb, seen=seen, resolution=0.01, origin=(0.0, 0.0))
+    boxes = boxes_from_heights(HeightGrid.from_points(_room(), resolution=0.05))
+    scene = build_scene(boxes, floor, name="test_room", ceiling=2.4)
+    model = mujoco.MjModel.from_xml_string(scene.xml, assets=scene.assets)
+    assert model.ngeom == len(boxes) + 2
+    tex = model.texture("test_room_floor")
+    img = model.tex_data[tex.adr[0] : tex.adr[0] + 300 * 400 * 3].reshape(300, 400, 3)
+    assert tuple(img[0, 0]) == (0, 0, 0)  # top row is +y: not the red half
+    assert tuple(img[-1, 0]) == (200, 50, 50)
+    assert tuple(img[-1, -1]) == UNSEEN_FLOOR_RGB  # unseen floor: the marker, not invented
+    floor_geom = model.geom("floor")
+    assert floor_geom.pos[:2] == pytest.approx([2.0, 1.5])
+
+
+def test_written_scene_parses_from_disk(tmp_path: Path) -> None:
+    floor = FloorPicture(
+        rgb=np.full((50, 50, 3), 90, np.uint8),
+        seen=np.ones((50, 50), bool),
+        resolution=0.02,
+        origin=(-0.5, -0.5),
+    )
+    path = build_scene([Box(0, 0, 0.2, 0.2, 0, 0.5)], floor, name="tiny").write(tmp_path)
+    assert mujoco.MjModel.from_xml_path(str(path)).ngeom == 2
+
+
+def test_scene_from_a_recorded_walk() -> None:
+    """go2_short: a real Go2's lidar (world frame) through a chairs room and store shelves."""
+    from dimos.memory.store.sqlite import SqliteStore
+
+    store = SqliteStore(path=str(get_data("go2_short.db")))
+    store.start()
+    try:
+        pts: list[np.ndarray] = []
+        lidar: Iterable[Any] = store.stream("lidar")
+        for k, obs in enumerate(lidar):
+            if k % 4 == 0:
+                p = obs.data.as_numpy()
+                pts.append(np.asarray(p[0] if isinstance(p, tuple) else p)[:, :3])
+    finally:
+        store.stop()
+    points = np.vstack(pts)
+    grid = HeightGrid.from_points(points, resolution=0.05, max_height=2.0)
+    boxes = boxes_from_heights(grid, min_cells=3)
+    assert 100 < len(boxes) < 20000
+    assert 0.0 < sum((b.x1 - b.x0) * (b.y1 - b.y0) for b in boxes) < 0.5 * grid.top.size * 0.05**2
+    scene = build_scene(boxes, name="go2_short")
+    model = mujoco.MjModel.from_xml_string(scene.xml, assets=scene.assets)
+    assert model.ngeom == len(boxes) + 1
+
+
+def test_inside_of_a_solid_is_filled_but_unseen_floor_is_not() -> None:
+    top = np.full((40, 40), np.nan, np.float32)
+    top[[0, -1], :] = top[:, [0, -1]] = 2.0  # a room's walls
+    top[10, 10:20] = top[19, 10:20] = top[10:20, 10] = top[10:20, 19] = 0.5  # a block's faces
+    bottom = np.where(np.isfinite(top), 0.1, np.nan)
+    seen = np.zeros(top.shape, bool)
+    seen[25:35, 25:35] = True  # some of the room's floor seen; the rest never
+    g = HeightGrid(bottom=bottom, top=top, resolution=0.1, origin=(0, 0))
+    boxes = boxes_from_heights(g, floor_seen=seen)
+    cover = np.zeros(top.shape, bool)
+    for b in boxes:
+        cover[round(b.y0 / 0.1) : round(b.y1 / 0.1), round(b.x0 / 0.1) : round(b.x1 / 0.1)] = True
+    assert cover[11:19, 11:19].all()  # the block's inside
+    assert not cover[2:8, 2:8].any()  # the room's unseen floor stays floor
+    assert not any(b.z0 > 0 for b in boxes)
