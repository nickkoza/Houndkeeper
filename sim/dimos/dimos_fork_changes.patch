+        self._qadr = np.array([model.jnt_qposadr[j] for j in jids])
+        self._vadr = np.array([model.jnt_dofadr[j] for j in jids])
+        self._act = np.array([actuator_of(j) for j in jids])
+        self._n_arm = len(joints)
+        self._has_gripper = bool(gripper)
+        self.camera_id = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_CAMERA, camera) if camera else -1
