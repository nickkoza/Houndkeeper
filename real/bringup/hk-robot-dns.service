# The laptop's logging-only resolver for the robot network ([VVJ], robot-network.md section 2): every name the robot
# looks up is logged and answered "no such domain". Listens only on the laptop's house addresses (real/.env), never
# 0.0.0.0 or the loopback, so it sits beside systemd-resolved. A template: @REPO@ and @USER@ are filled in on install.
[Unit]
Description=Houndkeeper robot network: logging-only DNS (nothing resolves)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
ExecStart=/usr/bin/python3 @REPO@/real/bringup/robot_logs.py dns
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
