# The house's network specifics for the robot network (dog-first-boot [MTv]). Copy to real/.env and fill in; real/.env
# and real/local/ are gitignored: names, addresses and the router's config stay out of the repository.
ROBOT_SSID=
ROBOT_PSK=
HOUSE_SSID=
HOUSE_PSK=
ROBOT_NET=
ROUTER_ON_ROBOT_NET=
ROBOT_IP=
ARM_HOST_IP=
LAPTOP_IP=
ROUTER_SCRIPT=real/local/robot-segment.rsc
LAPTOP_HOUSE_IPS=          # the laptop's fixed house addresses, comma-separated (real/bringup/robot_logs.py)
ROBOT_LOG_DIR=real/local/logs
ROBOT_SYSLOG_PORT=5514
ROUTER_HOST=                # the router's address for SSH (real/bringup/isolation_check.py; read-only)
ROUTER_USER=
ROUTER_PASS=
ROUTER_KNOWN_HOSTS=         # the router's recorded SSH host key (default real/local/router_known_hosts)
ROUTER_COMMENT_TAG=         # the comment prefix of the robot network's router items (default: ROBOT_SSID)
ROUTER_GUEST_IF=            # the guest network's interface on the router (default: any named *guest*)
ISOLATION_JSON=             # where the isolation check writes (default real/local/isolation.json)
ROBOT_DNS_ALLOW=            # online window only (first-boot.md step 1): exact names the laptop resolver answers
ROBOT_DNS_UPSTREAM=         # online window only: the router's house-side address(es), which answer them
