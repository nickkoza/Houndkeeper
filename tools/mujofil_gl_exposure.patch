+void Renderer::set_exposure(float ev) {                  // as the Vulkan renderer's: a built renderer's exposure, changed
+    if (ev == config_.exposure && color_grading_) return;  // without rebuilding it (houndkeeper)
+    config_.exposure = ev;
+    filament::ColorGrading* old = color_grading_;
+    setup_color_grading();
+    if (old) engine_->destroy(old);
+}
