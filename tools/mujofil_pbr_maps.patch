+void MaterialManager::update_texture_2d(int key, int width, int height, int nchannel, const uint8_t* data)
+{
+    auto it = texture_cache_.find(key);
+    if (it == texture_cache_.end() || !data) return;
+    filament::Texture* tex = it->second;
+    if ((int)tex->getWidth() != width || (int)tex->getHeight() != height) return;
+    const size_t px = static_cast<size_t>(width) * height;
+    auto* rgba = new uint8_t[px * 4];
+    for (size_t i = 0; i < px; ++i) {
+        const uint8_t* p = data + i * nchannel;
+        rgba[i * 4 + 0] = p[0];
+        rgba[i * 4 + 1] = nchannel >= 3 ? p[1] : p[0];
+        rgba[i * 4 + 2] = nchannel >= 3 ? p[2] : p[0];
+        rgba[i * 4 + 3] = nchannel >= 4 ? p[3] : 255;
+    }
+    filament::Texture::PixelBufferDescriptor pb(
+        rgba, px * 4, filament::Texture::Format::RGBA, filament::Texture::Type::UBYTE,
+        [](void* buf, size_t, void*) { delete[] static_cast<uint8_t*>(buf); });
+    tex->setImage(*engine_, 0, std::move(pb));
+    tex->generateMipmaps(*engine_);
+}
