+// --- flex bodies (Houndkeeper patch): cloth (dim 2) draws its triangles from both sides; a soft body (dim 3) its outer
+// shell. Positions and normals are rewritten from data->flexvert_xpos every frame (sync_flexes). ---
+static void tangent_quats(const std::vector<float>& v6, std::vector<int16_t>& q) {
+    const size_t n = v6.size() / 6; q.resize(n * 4);
+    for (size_t i = 0; i < n; ++i) {                          // Frisvad basis from the normal, as create_renderable does
+        float nx = v6[i*6+3], ny = v6[i*6+4], nz = v6[i*6+5], l = std::sqrt(nx*nx + ny*ny + nz*nz);
+        if (l > 1e-6f) { nx /= l; ny /= l; nz /= l; } else { nx = 0; ny = 0; nz = 1; }
+        float tx, ty, tz, bx, by, bz;
+        if (nz < -0.9999f) { tx = 0; ty = -1; tz = 0; bx = -1; by = 0; bz = 0; }
+        else { float a = 1.0f / (1.0f + nz), b = -nx * ny * a; tx = 1.0f - nx*nx*a; ty = b; tz = -nx; bx = b; by = 1.0f - ny*ny*a; bz = -ny; }
+        float tr = tx + by + nz, qw, qx, qy, qz;
+        if (tr > 0) { float s = 0.5f / std::sqrt(tr + 1.0f); qw = 0.25f / s; qx = (bz - ny) * s; qy = (nx - tz) * s; qz = (ty - bx) * s; }
+        else if (tx > by && tx > nz) { float s = 2.0f * std::sqrt(1.0f + tx - by - nz); qw = (bz - ny) / s; qx = 0.25f * s; qy = (ty + bx) / s; qz = (nx + tz) / s; }
+        else if (by > nz) { float s = 2.0f * std::sqrt(1.0f + by - tx - nz); qw = (nx - tz) / s; qx = (ty + bx) / s; qy = 0.25f * s; qz = (bz + ny) / s; }
+        else { float s = 2.0f * std::sqrt(1.0f + nz - tx - by); qw = (ty - bx) / s; qx = (nx + tz) / s; qy = (bz + ny) / s; qz = 0.25f * s; }
+        float ql = std::sqrt(qw*qw + qx*qx + qy*qy + qz*qz); if (ql > 0) { qw /= ql; qx /= ql; qy /= ql; qz /= ql; }
+        q[i*4+0] = (int16_t)(qx * 32767.0f); q[i*4+1] = (int16_t)(qy * 32767.0f); q[i*4+2] = (int16_t)(qz * 32767.0f); q[i*4+3] = (int16_t)(qw * 32767.0f);
+    }
+}
+
+void SceneBridge::create_flexes(const mjModel* model) {
+    flex_renderables_.clear();
+    for (int f = 0; f < model->nflex; ++f) {
+        const int dim = model->flex_dim[f], nv = model->flex_vertnum[f];
+        if (dim < 2 || nv < 3) continue;                       // lines (cables) have geoms of their own
+        FlexRenderable fr; fr.flex_id = f; fr.vadr = model->flex_vertadr[f]; fr.nv = nv; fr.two_sided = (dim == 2);
+        fr.radius = (float)model->flex_radius[f];              // drawn this far out, as MuJoCo draws a flex (its contact size)
+        if (dim == 2) {                                        // cloth: its elements are its triangles
+            const int* e = model->flex_elem + model->flex_elemdataadr[f];
+            for (int k = 0; k < model->flex_elemnum[f] * 3; ++k) fr.tris.push_back((uint32_t)e[k]);
+        } else {                                               // a soft body: its shell, the triangles facing out
+            const int* sh = model->flex_shell + model->flex_shelldataadr[f];
+            for (int k = 0; k < model->flex_shellnum[f] * 3; ++k) fr.tris.push_back((uint32_t)sh[k]);
+        }
+        if (fr.tris.empty()) continue;
+        std::vector<uint32_t> idx(fr.tris);
+        const int nvr = fr.two_sided ? 2 * nv : nv;
+        if (fr.two_sided)                                      // the back: its own vertices (flipped normals), wound the other way
+            for (size_t k = 0; k < fr.tris.size(); k += 3) { idx.push_back(fr.tris[k] + nv); idx.push_back(fr.tris[k+2] + nv); idx.push_back(fr.tris[k+1] + nv); }
+        std::vector<float> v6((size_t)nvr * 6, 0.0f); for (int i = 0; i < nvr; ++i) v6[i*6+5] = 1.0f;
+        ResolvedMaterial rm; const float* c = model->flex_rgba + f * 4;
+        const int mid = model->flex_matid[f];
+        if (mid >= 0) { const float* mc = model->mat_rgba + mid * 4; for (int k = 0; k < 4; ++k) rm.rgba[k] = mc[k]; }
+        else for (int k = 0; k < 4; ++k) rm.rgba[k] = c[k];
+        rm.roughness = 0.9f; rm.metallic = 0.0f; rm.reflectance = 0.3f;   // fabric: matte
+        std::vector<float> uvs;
+        const int ta = model->flex_texcoordadr[f];
+        if (mid >= 0 && ta >= 0) {                              // textured cloth: its texture coordinates, twice for the back
+            int texid = model->mat_texid[mid * mjNTEXROLE + mjTEXROLE_RGB];
+            if (texid >= 0 && model->tex_type[texid] == mjTEXTURE_2D) {
+                rm.albedo_2d = material_manager_->get_or_create_texture_2d(texid, model->tex_width[texid], model->tex_height[texid],
+                                                                            model->tex_nchannel[texid], model->tex_data + model->tex_adr[texid]);
+                rm.uvscale[0] = model->mat_texrepeat[mid * 2]; rm.uvscale[1] = model->mat_texrepeat[mid * 2 + 1];
+                for (int s = 0; s < (fr.two_sided ? 2 : 1); ++s)
+                    for (int i = 0; i < nv; ++i) { uvs.push_back(model->flex_texcoord[(ta + i) * 2]); uvs.push_back(model->flex_texcoord[(ta + i) * 2 + 1]); }
+            }
+        }
+        fr.gr = create_renderable(v6, idx, make_instance(rm), -1, uvs, true);
+        flex_renderables_.push_back(std::move(fr));
+    }
+}
+
+void SceneBridge::sync_flexes(const mjData* data) {
+    auto* engine = renderer_.engine();
+    for (auto& fr : flex_renderables_) {
+        const int nv = fr.nv, nvr = fr.two_sided ? 2 * nv : nv;
+        std::vector<float> v6((size_t)nvr * 6, 0.0f);
+        const mjtNum* x = data->flexvert_xpos + fr.vadr * 3;
+        for (int i = 0; i < nv; ++i) for (int k = 0; k < 3; ++k) v6[i*6+k] = (float)x[i*3+k];
+        for (size_t t = 0; t + 2 < fr.tris.size(); t += 3) {  // area-weighted vertex normals
+            const uint32_t a = fr.tris[t], b = fr.tris[t+1], cc = fr.tris[t+2];
+            float e1[3], e2[3], n[3];
+            for (int k = 0; k < 3; ++k) { e1[k] = v6[b*6+k] - v6[a*6+k]; e2[k] = v6[cc*6+k] - v6[a*6+k]; }
+            n[0] = e1[1]*e2[2] - e1[2]*e2[1]; n[1] = e1[2]*e2[0] - e1[0]*e2[2]; n[2] = e1[0]*e2[1] - e1[1]*e2[0];
+            for (uint32_t v : {a, b, cc}) for (int k = 0; k < 3; ++k) v6[v*6+3+k] += n[k];
+        }
+        for (int i = 0; i < nv; ++i) {                          // each side drawn its radius out along its normal: the vertices
+            float* n = &v6[i*6+3]; const float l = std::sqrt(n[0]*n[0] + n[1]*n[1] + n[2]*n[2]);   // rest that far from
+            if (l < 1e-9f) continue;                                // what they touch, so a bare surface would lie in the floor
+            for (int k = 0; k < 3; ++k) {
+                const float o = n[k] / l * fr.radius;
+                if (fr.two_sided) { v6[(nv+i)*6+k] = v6[i*6+k] - o; v6[(nv+i)*6+3+k] = -n[k]; }
+                v6[i*6+k] += o;
+            }
+        }
+        std::vector<int16_t> q; tangent_quats(v6, q);
+        auto* vp = new float[v6.size()]; std::memcpy(vp, v6.data(), v6.size() * sizeof(float));
+        fr.gr.vertex_buffer->setBufferAt(*engine, 0, filament::VertexBuffer::BufferDescriptor(vp, v6.size() * sizeof(float),
+            [](void* p, size_t, void*) { delete[] static_cast<float*>(p); }));
+        auto* qp = new int16_t[q.size()]; std::memcpy(qp, q.data(), q.size() * sizeof(int16_t));
+        fr.gr.vertex_buffer->setBufferAt(*engine, 1, filament::VertexBuffer::BufferDescriptor(qp, q.size() * sizeof(int16_t),
+            [](void* p, size_t, void*) { delete[] static_cast<int16_t*>(p); }));
+    }
 }
 
