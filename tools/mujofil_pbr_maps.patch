+filament::IndirectLight* LightManager::build_indirect(filament::Texture* refl, const filament::math::float3* sh, float intensity) {
+    // the ambient light, remembered so set_ambient_tint can rebuild it coloured
+    ibl_refl_ = refl; ibl_intensity_ = intensity;
+    for (int i = 0; i < 9; ++i) ibl_sh_[i] = sh[i];
+    filament::math::float3 t[9];
+    for (int i = 0; i < 9; ++i) t[i] = ibl_sh_[i] * tint_;
+    return filament::IndirectLight::Builder().reflections(refl).irradiance(3, t).intensity(intensity).build(*engine_);
+}
+
+void LightManager::set_ambient_tint(float r, float g, float b) {
+    // colour the ambient (indirect) light: Filament traces no bounces, so light that reached a room off its walls and
+    // floor, and took their colour, is approximated by tinting the ambient with it
+    tint_ = {r, g, b};
+    if (!indirect_light_ || !ibl_refl_) return;
+    float intensity = indirect_light_->getIntensity();
+    filament::IndirectLight* old = indirect_light_;
+    indirect_light_ = build_indirect(ibl_refl_, ibl_sh_.data(), ibl_intensity_);
+    indirect_light_->setIntensity(intensity);
+    scene_->setIndirectLight(indirect_light_);                // the scene lets go of the old one first
+    engine_->destroy(old);
+}
